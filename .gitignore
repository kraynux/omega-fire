# Environnement Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# État runtime généré localement (recréé automatiquement au démarrage)
var/db/
var/logs/
var/runtime/
var/cache/*
var/backups/*
var/exports/*
!var/cache/.gitkeep
!var/backups/.gitkeep
!var/exports/.gitkeep

# Secrets locaux
.env

# Éditeurs
*~
*.bak
*.swp

# Logs de test locaux
*.log
