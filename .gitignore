# Environnement Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
*.egg-info/
.coverage
htmlcov/

# Archives construites (build-release.sh) et omega-lib vendorisée à la construction
dist/
vendor/
omega-fire-*.tar.gz
omega-fire.tar.gz

# État runtime généré localement (recréé automatiquement au démarrage).
# TOUT var/ est ignoré (jeton, bans, bouclier WireGuard, journaux, base, réglages…) ; seuls les .gitkeep gardent
# les dossiers. Correctif du 2026-11-26 : var/bouclier-wg/ (3.7.0) n'était pas couvert par l'ancienne liste.
var/**
!var/
!var/*/
!var/*/.gitkeep

# Configuration et secrets locaux
config/omega-fire.conf
.env

# Outils et éditeurs
.claude/
*~
*.bak
*.swp

# Logs de test locaux
*.log

# Données personnelles et secrets : jamais publiés (correctif du 2026-11-22, après une fuite de var/ d'omega-stress)
**/omega-jeton.json
**/declaration.json
var/distributed/
var/**/*.key
var/**/settings.json
var/**/targets.json

# Sauvegardes locales et rapports d'audit de sécurité : jamais publiés (2026-11-26)
sauvegardes/
CLAUDE-SECURITY-*/
*.avant-*
