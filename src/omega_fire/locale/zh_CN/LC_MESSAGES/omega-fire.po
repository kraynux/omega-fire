msgid "Échec de l'opération « {operation} » du dépôt « {repository} » : {reason}"
msgstr "存储库 «{repository}» 的操作 «{operation}» 失败：{reason}"

#: src/omega_fire/infrastructure/storage/sqlite/exceptions.py:104
