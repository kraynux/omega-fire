#: src/omega_fire/plugins/builtin/conntrack.py:7
#: src/omega_fire/plugins/builtin/fail2ban.py:7
#: src/omega_fire/plugins/builtin/iptables.py:7
#: src/omega_fire/plugins/builtin/nftables.py:19
msgid "Omega-Fire Team"
msgstr "Omega-Fire Team"

#: src/omega_fire/plugins/builtin/conntrack.py:8
msgid "Monitoring des connexions via conntrack"
msgstr "Supervisión de las conexiones mediante conntrack"

#: src/omega_fire/plugins/builtin/fail2ban.py:8
msgid "Backend fail2ban pour la gestion des jails"
msgstr "Backend fail2ban para la gestión de los jails"

#: src/omega_fire/plugins/builtin/iptables.py:8
msgid "Backend iptables pour la gestion du pare-feu"
