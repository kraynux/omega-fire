msgstr "jail.local / jail.conf"

#: src/omega_fire/interfaces/tui/support/jail_origin.py:20
msgid "autre"
msgstr "outro"

#: src/omega_fire/interfaces/tui/support/log_viewers.py:16
msgid "Sélectionnez au moins un log."
msgstr "Selecione pelo menos um log."

#: src/omega_fire/interfaces/tui/support/log_viewers.py:35
#, python-brace-format
msgid "Fichier(s) introuvable(s), ignoré(s) : {value}"
msgstr "Arquivo(s) não encontrado(s), ignorado(s): {value}"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:24
msgid "24h"
msgstr "24h"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:24
msgid "30j"
msgstr "30d"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:24
msgid "7j"
msgstr "7d"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:24
msgid "Tout (fichier entier)"
msgstr "Tudo (arquivo inteiro)"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:26
msgid ""
"24h, 7j, 30j : lecture depuis la fin du fichier, rapide. « Tout » lit le "
"fichier entier : la durée dépend de sa taille (de quelques secondes à "
"plusieurs minutes pour un gros log)."
msgstr ""
"24h, 7d, 30d: leitura a partir do fim do arquivo, rápida. “Tudo” lê o "
"arquivo inteiro: a duração depende do tamanho dele (de alguns segundos a "
"vários minutos para um log grande)."

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:36
msgid "Lecture du fichier entier, ligne par ligne…"
msgstr "Leitura do arquivo inteiro, linha por linha…"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:37
msgid "Analyse des lignes (date, IP, code HTTP, chemin)…"
msgstr "Análise das linhas (data, IP, código HTTP, caminho)…"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:38
msgid ""
"Plus le fichier est gros, plus c'est long : quelques secondes à plusieurs "
"minutes."
msgstr ""
"Quanto maior o arquivo, mais demora: de alguns segundos a vários minutos."

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:39
msgid "Échap arrête l'analyse : il faudra la relancer."
msgstr "Esc interrompe a análise: será preciso iniciá-la de novo."

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:40
#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:45
msgid "Toujours en cours, rien n'est bloqué…"
msgstr "Ainda em andamento, nada está travado…"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:43
msgid ""
"Lecture depuis la fin du fichier, arrêt dès que les lignes sortent de la "
"période…"
msgstr ""
"Leitura a partir do fim do arquivo, parando assim que as linhas saem do "
"período…"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:44
msgid "Analyse des lignes de la période…"
msgstr "Análise das linhas do período…"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:95
#, python-brace-format
msgid "{count} log(s)"
msgstr "{count} log(s)"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:98
msgid " (au moins)"
msgstr " (no mínimo)"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:98
#, python-brace-format
msgid "environ {lines} lignes"
msgstr "cerca de {lines} linhas"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:144
msgid "Calcul en cours"
msgstr "Cálculo em andamento"

#: src/omega_fire/interfaces/tui/widgets/busy_indicator.py:154
