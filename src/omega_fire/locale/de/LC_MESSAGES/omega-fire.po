#: src/omega_fire/interfaces/tui/screens/table_management_screen.py:277
#, python-brace-format
msgid "Remettre input/output/forward à ACCEPT sur {backend} ?"
msgstr "input/output/forward auf {backend} auf ACCEPT zurücksetzen?"

#: src/omega_fire/interfaces/tui/screens/table_management_screen.py:280
msgid ""
"Ces outils comptent souvent sur une politique DROP (UFW met INPUT en DROP) :"
" à ACCEPT, tout paquet qu'aucune règle ne bloque explicitement est accepté. "
"Détails : touche « a »."
msgstr ""
"Diese Werkzeuge verlassen sich oft auf eine DROP-Richtlinie (UFW setzt INPUT"
" auf DROP): mit ACCEPT wird jedes Paket akzeptiert, das keine Regel "
"ausdrücklich blockiert. Details: Taste „a“."

#: src/omega_fire/interfaces/tui/screens/table_management_screen.py:286
msgid "CONFIRMER LA RÉINITIALISATION"
msgstr "ZURÜCKSETZEN BESTÄTIGEN"

