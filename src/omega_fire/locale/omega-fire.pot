#: src/omega_fire/interfaces/cli/help_text.py:65
msgid "Vue globale des backends détectés (nftables, iptables, fail2ban, systemd...) et de leur état : disponible, dégradé ou manquant. Point de départ pour comprendre pourquoi une fonctionnalité est grisée ailleurs dans le menu."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:71
msgid "Consulte 1.1 pour la vue d'ensemble, 1.3 si l'état affiché semble périmé (après une installation ou un changement système)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:78
msgid "Liste toutes les capacités détectées par le dernier scan système : quels backends/services sont disponibles, dégradés ou manquants."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:83
msgid "Aucune saisie requise — affiche directement le registre actuel."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:84
msgid "Suite omega : omega-serv (instances détectées et en service ; « dégradé » si aucune ne tourne), omega-waf (extra magnet activé dans une instance) et omega-jail (jails installés dans /etc/fail2ban/jail.d)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:89
msgid "Lecture seule : ne relance aucun scan, affiche l'état déjà en mémoire (voir 1.3 pour rafraîchir)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:93
msgid "Si l'appli vient de démarrer sur une machine où un service a changé d'état entre-temps, l'information peut être obsolète — relance un scan (1.3) si besoin."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:101
msgid "Affiche le détail complet d'une capacité précise (ex: nftables, fail2ban) : statut, raison si dégradée/manquante, informations de diagnostic."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:106
msgid "Sélectionne par numéro, ou saisis directement l'identifiant de la capacité (visible via 1.1)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:109
#: src/omega_fire/interfaces/cli/help_text.py:138
#: src/omega_fire/interfaces/cli/help_text.py:177
#: src/omega_fire/interfaces/cli/help_text.py:257
#: src/omega_fire/interfaces/cli/help_text.py:578
#: src/omega_fire/interfaces/cli/help_text.py:656
#: src/omega_fire/interfaces/cli/help_text.py:726
#: src/omega_fire/interfaces/cli/help_text.py:853
#: src/omega_fire/interfaces/cli/help_text.py:859
#: src/omega_fire/interfaces/cli/help_text.py:865
#: src/omega_fire/interfaces/cli/help_text.py:871
msgid "Lecture seule."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:114
msgid "Relance les sondes système (nftables, iptables, fail2ban, systemd...) pour mettre à jour le registre des capacités."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:117
msgid "Aucune saisie — lance directement le scan."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:119
msgid "Met à jour le registre en mémoire — peut changer ce qui est grisé/disponible ailleurs dans les menus. Une capacité redevenue disponible débloque immédiatement les actions qui en dépendent, sans redémarrer l'application."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:125
msgid "Des erreurs partielles sont possibles (ex: une sonde échoue) sans faire échouer tout le scan — le résumé affiché indique combien d'erreurs ont eu lieu, à vérifier si le nombre de composants disponibles semble anormalement bas."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:134
msgid "Affiche les erreurs et dégradations récentes détectées sur le système (capacités manquantes/dégradées et pourquoi)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:137
#: src/omega_fire/interfaces/cli/help_text.py:725
#: src/omega_fire/interfaces/cli/help_text.py:864
#: src/omega_fire/interfaces/cli/help_text.py:870
msgid "Aucune saisie requise."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:143
msgid "Consulte ou purge le journal interne d'Omega-Fire (actions effectuées, erreurs, avertissements) — pas les logs système (Nginx, auth.log...), voir la section 5 pour ceux-là."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:148
msgid "Mode consultation : choisis un nombre de lignes (50/100/personnalisé), un mot-clé optionnel, puis navigue page par page (Entrée pour continuer, q pour arrêter)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:151
msgid "Mode gestion/purge : supprime les entrées de plus de 30/120 jours, avant une date précise, ou les N plus anciennes — une confirmation est toujours demandée avant suppression."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:156
msgid "La consultation est en lecture seule. La purge supprime réellement des entrées du journal, de façon irréversible."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:160
msgid "Erreurs et alertes critiques sont mises en évidence par couleur — pour chercher un problème précis, filtre par mot-clé plutôt que de tout parcourir."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:168
msgid "Recherche un mot-clé (IP, nom de backend, message d'erreur...) à la fois dans les diagnostics système et dans le journal applicatif, en une seule requête."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:173
msgid "Saisis un mot-clé — la recherche combine automatiquement les deux sources (diagnostics + journal), jusqu'à 15 résultats du journal affichés."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:182
msgid "Exporte un rapport de l'état système et des diagnostics dans un fichier : JSON (données brutes), HTML (rapport visuel, par défaut) ou TXT (texte brut)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:187
msgid "Choisis le format, puis valide le chemin de destination proposé ou saisis-en un autre."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:191
msgid "Écrit un fichier réel sur disque (par défaut dans le dossier d'exports) — ne modifie rien côté système."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:203
msgid "Gestion unifiée des IPs bannies à travers tous les backends détectés (nftables, iptables, fail2ban) : bannir, débannir, lister, synchroniser, importer/exporter, purger."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:208
msgid "La plupart des actions agissent par défaut sur tous les backends disponibles simultanément — cibler un seul backend reste possible mais est pensé pour du diagnostic, pas un usage courant."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:216
msgid "Bannit une seule IP, sur tous les backends détectés par défaut (nftables/iptables/fail2ban)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:218
msgid "Saisis l'IP, choisis les backends cibles (tous par défaut, ou un seul pour diagnostic), ajoute un commentaire optionnel, puis confirme."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:223
msgid "L'IP est bloquée immédiatement sur chaque backend ciblé. Un rapport par backend indique succès, doublon (déjà bannie) ou échec."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:227
msgid "Cibler un seul backend est un mode diagnostic : si un autre backend est actif, l'IP pourrait rester accessible via ce dernier."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:234
msgid "Bannit une liste d'IPs en une fois, depuis une saisie manuelle ou un fichier (défaut, fichier fail2ban par défaut, dossier var/blocklist/, fichier épinglé, ou chemin personnalisé)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:238
msgid "Choisis la méthode d'approvisionnement, puis valide la liste d'IPs extraite avant le bannissement effectif."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:239
msgid "Chaque IP valide extraite est bannie sur les backends ciblés, comme pour 2.1 mais en masse."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:243
msgid "Débannit une seule IP, sur tous les backends détectés par défaut."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:244
msgid "Même déroulé que 2.1, en sens inverse : saisis l'IP, choisis les backends, confirme."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:245
msgid "L'IP redevient accessible immédiatement sur chaque backend ciblé."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:249
msgid "Débannit une liste d'IPs en une fois — même logique d'approvisionnement que 2.2."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:250
msgid "Choisis la méthode d'approvisionnement, valide la liste, confirme."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:251
msgid "Chaque IP de la liste est débannie sur les backends ciblés."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:255
msgid "Liste toutes les IPs actuellement bannies, avec leur backend d'origine et leur commentaire/source."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:256
msgid "Choisis un backend précis ou consulte tous les backends d'un coup."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:261
msgid "Réconcilie les backends entre eux : ajoute sur chaque backend cible les IPs déjà bannies ailleurs mais manquantes chez lui."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:262
msgid "Choisis les backends à synchroniser (tous par défaut)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:263
msgid "Additif uniquement : ne retire jamais une IP, ajoute seulement celles manquantes pour aligner les backends."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:268
msgid "Gestion complète des fichiers de blocklist dans var/blocklist/ : créer, importer depuis un autre dossier, éditer IP par IP, renommer, supprimer, et bannir directement le contenu d'un fichier."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:272
msgid "Sélectionne un fichier existant pour l'éditer, ou utilise [I]/[N] pour en importer/créer un nouveau."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:274
msgid "Les modifications (ajout/retrait d'IP, renommage, suppression) touchent le fichier réel sur disque — bannir depuis un fichier ici bannit réellement les IPs valides qu'il contient."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:281
msgid "Exporte les IPs actuellement bannies vers un fichier (défaut, backup horodaté, fichier existant, récent, chemin manuel, ou fichier épinglé)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:282
msgid "Choisis la destination et le mode d'écriture (écraser ou ajouter au fichier existant)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:283
msgid "Écrit un fichier réel — ne modifie aucun état de bannissement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:287
msgid "PURGE : débannit toutes les IPs sur les backends ciblés (tous par défaut)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:288
msgid "Une confirmation explicite est demandée avant exécution."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:290
msgid "Toutes les IPs actuellement bannies sur les backends ciblés sont débannies. Les règles de filtrage principales (ports autorisés, accès SSH...) restent intactes — seule la liste des IPs bannies est vidée."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:295
msgid "Cibler un seul backend est un mode diagnostic — une IP bannie ailleurs resterait bloquée malgré cette purge."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:300
msgid "Transfère des IPs entre jails fail2ban, vers/depuis les backends firewall (nftables/iptables), ou depuis/vers des fichiers — raccourci vers la même action que 4.3, accessible directement depuis la section IPs."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:306
#: src/omega_fire/interfaces/cli/help_text.py:485
msgid "Choisis d'abord une source (un jail, un backend, un fichier), puis une destination."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:308
#: src/omega_fire/interfaces/cli/help_text.py:487
msgid "Un récapitulatif (IPs déjà présentes / nouvelles / échecs) s'affiche après l'opération — vérifie-le avant de continuer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:312
#: src/omega_fire/interfaces/cli/help_text.py:491
msgid "Les IPs transférées vers un jail ou un backend sont réellement bannies à la destination, pas juste copiées dans une liste."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:316
#: src/omega_fire/interfaces/cli/help_text.py:495
msgid "Le transfert vers nftables crée automatiquement la chaîne de blocage si elle n'existe pas encore — normal, pas une erreur si tu la vois apparaître pour la première fois."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:328
msgid "Gestion fine des règles de pare-feu (ports, protocoles, réseaux) sur nftables/iptables, indépendamment du bannissement d'IP (section 2)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:330
msgid "Une règle est en général créée sur les deux backends disponibles simultanément — un profil restrictif actif sur un seul backend peut annuler l'effet d'une règle posée sur l'autre (voir 3.1)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:338
msgid "Assistant pas-à-pas pour créer une règle avancée (source, port, protocole, action) sur un ou plusieurs backends."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:339
msgid "Réponds aux questions successives : backend(s) cible(s), puis les paramètres de la règle."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:340
msgid "La règle est appliquée immédiatement sur les backends ciblés et enregistrée en base pour réapparaître dans 3.2/3.3."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:342
msgid "Deux backends actifs au même point de contrôle fonctionnent en INTERSECTION, pas en union : créer une règle ACCEPT sur un seul backend ne suffit pas si l'autre bloque toujours ce trafic — il reste refusé tant que les deux ne l'autorisent pas. Cibler un seul backend est réservé au diagnostic."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:351
msgid "Supprime une ou plusieurs règles, sélectionnées par ID (règles Omega-Fire créées via 3.1, règles système importées, ou les deux) — ou nettoie en un clic toutes les règles INACTIVES."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:353
msgid "Filtre l'affichage (Omega-Fire / Système / Toutes), puis saisis un ou plusieurs IDs séparés par une virgule."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:354
msgid "Si des règles inactives existent, une option [4] apparaît pour toutes les supprimer d'un coup (une seule confirmation, sans sélection ID par ID) — utile quand la majorité des règles importées du système sont inactives."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:355
msgid "« Nettoyer et resynchroniser la base » : remet la liste des règles d'accord avec ce que le pare-feu contient vraiment. Un aperçu s'affiche d'abord (lignes gardées, doublons, lignes absentes du noyau, lignes d'un backend absent de la machine, règles du noyau à importer) ; les lignes qui seront retirées apparaissent dans le tableau."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:358
msgid "Suppression réelle et immédiate sur le(s) backend(s) où la règle est active."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:359
msgid "Nettoyer et resynchroniser : seule la base d'Omega-Fire change, aucune règle n'est ajoutée ni retirée du pare-feu. La base est sauvegardée avant, dans var/backups/db/."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:362
msgid "Les règles système importées (déjà présentes avant Omega-Fire) peuvent être supprimées ici aussi — vérifie l'origine affichée avant de confirmer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:363
msgid "Une règle posée par un autre outil (UFW, Tailscale, Docker…, nom affiché dans la colonne Origine) n'est pas supprimée ici : elle se gère avec son outil, qui la recréerait ou deviendrait incohérent."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:364
msgid "Nettoyer et resynchroniser : un backend illisible (droits, erreur) n'est jamais touché ; un backend dont la commande est absente de la machine voit ses lignes retirées."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:369
msgid "Liste toutes les règles détaillées, avec compteurs par backend."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:370
msgid "Aucune saisie — une synchronisation depuis les backends actifs est faite automatiquement avant l'affichage."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:372
msgid "Lecture seule, mais met à jour la base locale de règles avec l'état réel du noyau avant de l'afficher — ce que tu vois reflète toujours l'état courant, pas un instantané périmé."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:375
msgid "Colonne Origine : OMEGA (créée par Omega-Fire), SYSTEME (présente avant, ou ajoutée à la main), ou le nom de l'outil qui l'a posée (UFW, Tailscale, Docker, Fail2Ban, firewalld…). Les règles d'autres outils sont affichées pour information : Omega-Fire ne les modifie pas."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:380
msgid "Applique un profil de sécurité pré-défini (politique complète de règles) sur les backends disponibles."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:382
msgid "L'état du profil actuellement actif (le cas échéant) est affiché avant de proposer les profils disponibles."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:383
msgid "Si des règles d'autres outils (UFW, Tailscale, Docker…) sont présentes sur iptables / ip6tables, tu choisis : appliquer sur tous les backends, appliquer seulement sur nftables, ou annuler. Le message indique combien de règles de chaque outil sont concernées."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:386
msgid "Remplace la politique de filtrage active par celle du profil choisi, sur tous les backends disponibles en même temps (nftables, iptables, ip6tables)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:387
msgid "Réappliquer le même profil ne crée pas de doublons : chaque backend est vidé puis reconstruit, et la base d'Omega-Fire est remise d'accord avec lui."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:388
msgid "nftables : seule la table d'Omega-Fire (inet filter) est vidée ; les tables des autres outils ne sont pas touchées."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:389
msgid "iptables / ip6tables : toute la table filter est vidée (iptables -F, -X), y compris les chaînes et les règles des autres outils (ufw-*, ts-*…). La politique par défaut d'INPUT / OUTPUT / FORWARD devient celle du profil."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:390
msgid "Une sauvegarde automatique (snapshot) est tentée avant application ; 7.2 peut la restaurer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:393
msgid "Tous les backends, avec UFW ou Tailscale : leurs règles disparaissent du noyau jusqu'au prochain rechargement de l'outil (« ufw reload », redémarrage du service Tailscale ou de la machine). Entre-temps, seul le profil d'Omega-Fire protège la machine — et un accès autorisé par UFW (ex. Samba, VNC limités au réseau local) peut être bloqué."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:394
msgid "Seulement nftables : les règles des autres outils restent en place. Les deux pare-feu s'appliquent alors ensemble : un paquet doit être accepté par les deux. Un profil strict peut bloquer un accès qu'UFW autorise, et inversement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:395
msgid "La restauration 7.2 d'un snapshot ne repose pas les règles des autres outils : c'est à l'outil lui-même de les recréer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:400
msgid "Gestion des tables : diagnostic des tables et des politiques, initialisation de la table nftables d'Omega-Fire, remise des politiques à ACCEPT, vidage d'un backend ou de tous, suppression de la table nftables (avancé)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:402
msgid "Le diagnostic s'affiche toujours en haut ; choisis ensuite l'action, et le backend quand elle en demande un."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:403
msgid "Politiques différentes selon les backends : le noyau fait passer chaque paquet par toutes les chaînes branchées au même endroit (table nftables d'Omega-Fire et tables d'UFW via iptables-nft) ; un paquet doit être accepté par chacune, la politique la plus stricte l'emporte. « nftables ACCEPT, iptables DROP » n'ouvre donc rien : c'est iptables qui décide."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:404
msgid "Pour chaque politique DROP, la cause est indiquée : outil qui l'a posée (UFW…, rien à faire), profil Omega-Fire actif (rien à faire), politique orpheline sans aucune règle (affichée en jaune : tout est bloqué sur ce backend, remède « Remettre les politiques à ACCEPT » ou appliquer un profil), ou politique DROP avec des règles mais sans profil (vérifier en 3.3)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:405
msgid "Initialiser la table nftables crée ses chaînes en ACCEPT : sur une machine filtrée par UFW, une différence de politique apparaît alors, c'est normal."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:406
msgid "Si des règles d'autres outils (UFW, Tailscale, Docker…) sont présentes sur iptables / ip6tables, la confirmation l'indique, avec le nombre de règles par outil ; pour « vider tous les backends », tu peux choisir de ne vider que nftables."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:409
msgid "Vider nftables : seule la table d'Omega-Fire est vidée."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:410
msgid "Vider iptables / ip6tables : toute la table filter est vidée (iptables -F), règles des autres outils comprises ; leurs chaînes restent, vides. La politique par défaut ne change pas."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:411
msgid "Remettre les politiques à ACCEPT : input, output et forward acceptent tout paquet qu'aucune règle ne bloque explicitement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:414
msgid "Vider iptables avec UFW : si la politique d'INPUT est DROP (cas d'UFW), plus aucun paquet entrant n'est accepté sur ce backend, connexions déjà ouvertes comprises — risque de perdre un accès distant (SSH). « ufw reload » repose les règles d'UFW."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:415
msgid "Remettre les politiques à ACCEPT avec UFW : UFW compte sur INPUT en DROP ; à ACCEPT, la machine accepte tout ce qu'UFW n'interdit pas explicitement. « ufw reload » rétablit sa politique."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:416
msgid "Les deux actions combinées (vider puis ACCEPT) laissent la machine sans aucun filtrage sur ce backend."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:427
msgid "Gestion complète du démon fail2ban : consulter l'état des jails, bannir/débannir des IPs, transférer des IPs entre jails ou vers les backends firewall, créer/supprimer/vider des jails, exporter, vérifier la configuration, piloter le service."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:433
msgid "Nécessite fail2ban installé et fail2ban-client accessible."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:434
msgid "Chaque sous-menu agit sur un jail précis ou sur l'ensemble des jails — vérifie bien le nom du jail affiché avant de valider une action large (Vider un jail, Vider tous les jails)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:442
msgid "Affiche un tableau récapitulatif de tous les jails configurés (nom, statut, nombre d'IPs bannies) puis propose un sous-menu d'analyse : lister les IPs d'un jail, de tous les jails, ou rechercher dans quel(s) jail(s) une IP précise est bannie."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:448
msgid "Le scan est lancé automatiquement à l'ouverture. Ensuite, choisis [1] pour un jail précis (par son numéro dans le tableau), [2] pour tout lister, ou [3] pour rechercher une IP spécifique."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:452
msgid "Lecture seule : ne modifie rien. La colonne Origine indique qui a défini le jail : Omega-Fire (4.4), omega-jail, la configuration principale de fail2ban (jail.local / jail.conf) ou un autre fichier."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:454
msgid "Lit directement la base de données de fail2ban et les fichiers de configuration pour rester rapide même avec beaucoup de jails, plutôt que d'interroger fail2ban-client un par un."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:461
msgid "Bannit ou débannit une ou plusieurs IPs dans un jail précis que tu choisis."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:463
msgid "Sélectionne d'abord le jail cible, puis l'action (bannir/débannir), puis saisis une IP unique ou une liste."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:467
msgid "Modifie l'état réel du jail immédiatement — l'IP est bloquée/débloquée dès validation, pas seulement enregistrée quelque part."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:471
msgid "Une IP déjà bannie ne peut pas être bannie une seconde fois (et inversement pour le débannissement) — l'action échoue proprement dans ce cas plutôt que de prétendre avoir réussi."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:474
msgid "Vérifie le nom du jail affiché avant de valider : une IP bannie dans le mauvais jail ne protège pas la bonne surface."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:481
msgid "Transfère des IPs entre jails fail2ban, vers/depuis les backends firewall (nftables/iptables), ou depuis/vers des fichiers."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:503
msgid "Assistant de création d'un nouveau jail : mode sur-mesure (tu choisis chaque paramètre) ou mode preset (modèles pré-configurés pour Nginx, Apache, Caddy, SSH...)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:508
msgid "Mode sur-mesure : nom du jail, chemin de log à surveiller (liste épinglée modifiable directement depuis cet écran), ports concernés, nom du filtre, règles de bannissement (maxretry / findtime / bantime)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:512
msgid "Mode preset : choisis directement un modèle déjà réglé."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:515
msgid "Écrit un fichier de configuration réel et recharge fail2ban — le jail devient actif immédiatement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:517
msgid "Si le filtre demandé n'existe pas encore, un filtre générique (détection d'erreurs HTTP 400/401/403/404/500) est créé automatiquement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:522
msgid "Le filtre générique automatique est pensé pour des logs HTTP (Nginx/Apache/Caddy/Lighttpd) — appliqué à un log qui n'a pas ce format (ex: syslog), il ne détectera jamais rien."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:525
msgid "Pour omega-serv et omega-waf, omega-jail installe en une commande des jails déjà réglés (WAF, Active Defense, scans, force brute) : l'écran le rappelle quand omega-serv est détecté sans omega-jail."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:530
msgid "Supprime un jail : arrête son suivi, retire sa configuration et recharge fail2ban."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:532
msgid "Choisis le jail à supprimer et confirme. Chaque jail est listé avec son origine et le fichier qui le définit, retrouvé par le nom de sa section, quel que soit le nom du fichier."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:535
msgid "Les IPs actuellement bannies dans ce jail sont libérées quand le jail est arrêté — consulte 4.1 avant si tu veux connaître son contenu."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:537
msgid "Son fichier de jail.d est supprimé, ainsi que son filtre s'il lui est propre (créé par Omega-Fire ou par omega-jail) ; un filtre standard de fail2ban (sshd…) n'est jamais supprimé."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:540
msgid "Irréversible sans recréer le jail depuis zéro (4.4)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:541
msgid "Jail installé par omega-jail : la confirmation le signale ; omega-jail le recréera à sa prochaine installation (« omega-jail --apply »)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:542
msgid "Jail défini dans jail.local / jail.conf, ou dans un fichier de jail.d qui définit aussi d'autres jails : rien n'est supprimé, le message explique comment le désactiver ou retirer sa section à la main."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:547
msgid "Débannit toutes les IPs d'un seul jail (celui que tu choisis), sans toucher aux autres."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:548
msgid "Sélectionne le jail à vider et confirme."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:549
msgid "Toutes les IPs actuellement bannies dans ce jail précis sont débannies immédiatement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:551
msgid "Ne touche qu'au jail sélectionné — pour vider tous les jails d'un coup, utilise 4.7, pas cette option répétée plusieurs fois."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:557
msgid "PURGE GÉNÉRALE : débannit toutes les IPs de tous les jails configurés, en une seule opération."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:558
msgid "Une confirmation est demandée avant exécution — lis-la attentivement, l'opération touche l'ensemble des jails."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:559
msgid "Toutes les IPs actuellement bannies, dans tous les jails, sont débannies immédiatement. Non sélectif."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:560
msgid "Opération large et irréversible — pour ne vider qu'un seul jail, utilise 4.6."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:565
msgid "Exporte le contenu d'un jail (IPs bannies, configuration) dans un fichier : brut, JSON, TXT (réinjectable), ou HTML (rapport visuel)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:568
msgid "Choisis le jail, puis le format de sortie."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:569
msgid "Lecture seule côté fail2ban — l'export ne modifie aucun jail."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:574
msgid "Teste la validité de la configuration fail2ban actuelle (jails, filtres) sans rien modifier ni redémarrer le service."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:577
msgid "Aucune saisie — lance directement le test."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:580
msgid "Valide la configuration sur disque sans nécessiter que le démon soit déjà démarré."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:587
msgid "Contrôle du service fail2ban lui-même (pas d'un jail précis) : statut, démarrage, arrêt, redémarrage, activation/désactivation au démarrage du système."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:591
msgid "Choisis l'action à effectuer sur le service."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:593
msgid "Arrêter le service désactive toute la protection fail2ban le temps qu'il est arrêté, pas seulement un jail."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:597
msgid "À utiliser avec précaution sur une machine en production — un arrêt du service, même bref, laisse temporairement passer les tentatives que fail2ban aurait bloquées."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:610
msgid "Analyse et maintenance des logs : Bibliothèque (import des logs), favoris, lecture avec trois lecteurs, analyse de fréquence par IP, purge ciblée, rotation/backup, restauration, statistiques."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:615
msgid "Les fichiers épinglés (« Gérer les épingles », avec ses presets) forment une seule liste, partagée par 5.4 à 5.6, 2.2, 2.4, 2.7, 2.8, 4.3 (et 2.10), 4.4 et 6.1. La Bibliothèque 5.1, qui alimente 5.2 et 5.3, est une liste distincte."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:623
msgid "Bibliothèque de logs : l'import des logs qui alimentent 5.2 Favoris et 5.3 Voir les logs. Rien ne se lance d'ici."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:625
msgid "Mode automatique : à chaque ouverture, les journaux des instances omega-serv détectées sur la machine (access.log, error.log, waf-alerts.log du WAF natif, active-defense…) sont ajoutés, ainsi que ceux d'omega-waf aux chemins de l'extra magnet, même hors de var/log/. Un journal retiré à la main n'est plus réimporté automatiquement ; « Importer omega-serv » les réimporte tous."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:626
msgid "Épingler un chemin : saisis le chemin absolu d'un log (ex. /var/log/nginx/access.log)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:627
msgid "Sources distantes (SSH) : enregistre une machine du réseau (hôte, chemin distant, utilisateur, port, clé), puis « Récupérer maintenant » copie le log par scp dans var/log/remote/ et l'ajoute à la Bibliothèque."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:630
msgid "La Bibliothèque ne contient que des références : retirer un log ne supprime pas le fichier. L'état (taille, absent, vide) est relu à chaque affichage."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:631
msgid "Une copie distante n'est pas suivie en direct : relance « Récupérer maintenant » pour la mettre à jour."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:634
msgid "SSH : aucune invite de mot de passe n'est possible depuis l'interface. Il faut une clé ou un agent SSH déjà configurés pour l'utilisateur qui lance omega-fire (root avec sudo)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:635
msgid "Les instances omega-serv sont détectées par leur service systemd (omega-serv*.service) et par leur registre d'instances ; une instance lancée à la main n'est pas vue : épingle ses journaux."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:640
msgid "Favoris : combiner des logs de la Bibliothèque, les enregistrer sous un nom avec un lecteur, et les lancer directement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:642
msgid "Choisis les numéros des logs (ex. 1,3), un nom et un lecteur, puis « Enregistrer ». « Lancer » ouvre le favori en surbrillance."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:644
msgid "Lecture seule sur les logs ouverts."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:646
msgid "Plusieurs logs combinés : lnav seul, le seul lecteur qui sait les fusionner en une vue chronologique ; un autre lecteur est refusé à l'enregistrement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:647
msgid "Un log retiré de la Bibliothèque reste dans le favori, mais ne s'ouvre plus s'il n'existe plus."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:652
msgid "Voir un log de la Bibliothèque sans configuration, avec le lecteur de ton choix."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:654
msgid "Choisis la ligne, puis le lecteur : Simple (tableau de bord temps réel : trafic, statistiques, dernières requêtes), Classique (dernières lignes puis suivi en direct à la demande), ou lnav (navigation, recherche, filtres)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:657
msgid "lnav sur un gros fichier peut afficher un écran noir quelques secondes, le temps de l'indexation : ce n'est pas un blocage."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:661
msgid "Analyse un fichier log ou une blocklist pour en extraire le classement des IPs les plus actives (Top N), sur une période choisie."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:663
msgid "Choisis la source (épinglée, manuelle, ou ajout/retrait d'épingle), la période d'analyse (1h/1j/7j/personnalisée), puis le nombre N d'IPs à afficher."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:664
msgid "Après l'analyse, « Exporter » enregistre le classement (JSON, TXT ou HTML) dans le dossier d'exports : 5.5 peut ensuite recharger ces IPs pour les retirer des logs, sans les recopier à la main, et 6.6 les affiche."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:665
msgid "« Gérer les épingles » → « Presets » propose les chemins usuels (logs système, serveurs web, blocklists d'omega-fire, logs de la Bibliothèque 5.1) présents sur cette machine : coche ceux à épingler."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:666
#: src/omega_fire/interfaces/cli/help_text.py:677
#: src/omega_fire/interfaces/cli/help_text.py:687
#: src/omega_fire/interfaces/cli/help_text.py:884
#: src/omega_fire/interfaces/cli/help_text.py:907
msgid "Les logs de la Bibliothèque (5.1) sont proposés en tête de liste, avant vos épingles."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:667
msgid "« Rechercher cette IP » compte ses lignes dans le fichier entier ; « Retirer cette IP du log analysé » retire l'IP choisie (ligne du tableau ou recherche) après confirmation, comme 5.5. L'analyse tourne sans figer l'interface."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:669
msgid "Lecture seule, sauf « Retirer cette IP du log analysé », qui modifie réellement le fichier. « Exporter » écrit un fichier top-ips_<date> dans le dossier d'exports."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:673
msgid "Retire toutes les lignes contenant une IP précise dans un fichier source (log ou blocklist) — édition directe du fichier, pas un débannissement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:675
msgid "Choisis le fichier source, saisis une ou plusieurs IPs (séparées par des virgules), vérifie le récapitulatif (lignes trouvées par IP) avant de confirmer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:676
msgid "« Charger depuis un export » liste les exports contenant des IPs (Top N de 5.4 en premier, puis blacklist 6.1 et jails 4.8) : choisis le fichier, coche les IPs à retirer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:679
msgid "Modifie réellement le fichier — les lignes contenant l'une des IPs sont supprimées, les autres conservées."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:680
msgid "N'agit que sur le fichier choisi, pas sur l'état réel du firewall/fail2ban — pour débannir une IP, utilise 2.3 ou 4.2."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:684
msgid "Sauvegarde (backup) manuelle ou automatisée de fichiers logs/blocklists dans une archive."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:686
msgid "Choisis la source à sauvegarder, puis le mode : sauvegarde immédiate, planification d'une automatisation récurrente, ou gestion des automatisations existantes."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:688
msgid "Une automatisation choisit une fréquence et le nombre de sauvegardes conservées. « Lister et gérer » montre la dernière sauvegarde, la prochaine et le résultat, et permet de réinstaller ou désinstaller l'exécution."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:691
msgid "Crée une archive réelle dans var/backups/. Les automatisations s'exécutent chaque nuit (timer systemd omega-fire-rotation, sinon une ligne de la crontab de root) : la première installe cette exécution, la dernière supprimée la retire."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:695
msgid "La tâche tourne en root, comme omega-fire : les logs protégés sont aussi sauvegardés. Une sauvegarde en échec est retentée la nuit suivante."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:699
msgid "Restaure une archive de logs précédemment sauvegardée (menu 5.6), immédiatement ou selon une automatisation planifiée."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:700
msgid "Choisis le mode (restauration immédiate, planification, gestion des automatisations existantes), puis l'archive et la stratégie de restauration."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:701
msgid "Écrit réellement les fichiers restaurés — une restauration peut écraser des fichiers actuels selon le mode choisi."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:702
msgid "Vérifie la stratégie/mode proposés avant de confirmer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:706
msgid "Purge et nettoie les archives de backup (var/backups/) selon différents critères : ancienneté, quota, type (sauvegardes automatiques de sécurité), ou sélection manuelle."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:707
msgid "Consulte d'abord les statistiques de stockage affichées (nombre d'archives, volume, espace disque libre), puis choisis le critère de purge."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:708
msgid "Suppression réelle et irréversible des archives ciblées — une confirmation avec aperçu des fichiers concernés est demandée avant exécution."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:712
msgid "Nettoyage avancé de l'espace de stockage interne d'Omega-Fire (logs, cache, exports, backups, ou tout var/), filtré par âge ou taille."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:713
msgid "Choisis le(s) dossier(s) cible(s), puis les critères de filtrage, et vérifie l'aperçu des fichiers concernés avant de confirmer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:714
msgid "Suppression réelle et irréversible des fichiers correspondants."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:716
msgid "app.log et audit.log sont toujours exclus de ce nettoyage, même si le dossier logs/ est ciblé — ce sont des fichiers actifs en écriture continue ; utilise 1.5 ou 7.3 pour les gérer spécifiquement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:724
msgid "Affiche un tableau de bord de statistiques sur les logs (volumes, tendances)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:725
msgid "Vue rapide : le rapport complet et exportable des logs est en 6.5."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:735
msgid "Centralise les exports et rapports : blacklist complète, règles de pare-feu, audit système complet, statistiques fail2ban, statistiques des logs (6.5) — et 6.6 pour les retrouver et les ouvrir."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:736
msgid "Chaque export propose un format (JSON/TXT/HTML selon le rapport) et un chemin de destination modifiable."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:740
msgid "Exporte la blacklist complète (IPs bannies) depuis un fichier source choisi, au format JSON, TXT ou HTML."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:741
msgid "Choisis la source (épinglée, manuelle, ou gestion des épingles), puis le format de sortie."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:742
msgid "Écrit un fichier réel — lecture seule côté bannissement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:746
msgid "Exporte les règles de pare-feu nftables/iptables (fail2ban a son propre export, voir 4.8) — toutes, actives seulement, Omega-Fire uniquement, ou système importées uniquement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:747
msgid "Choisis le contenu à exporter, puis le format (JSON/HTML/TXT)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:748
msgid "Écrit un fichier réel — lecture seule côté règles."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:752
msgid "Génère un rapport d'audit complet : état système, historique, top IPs, en un seul document."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:753
msgid "Choisis le format (TXT ou HTML), valide le chemin de destination proposé ou saisis-en un autre."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:754
msgid "Écrit un fichier réel — lecture seule côté système."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:758
msgid "Exporte un rapport détaillé sur fail2ban (jails et bans), au format TXT ou HTML."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:759
msgid "Choisis le format, valide ou modifie le chemin de destination proposé."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:760
msgid "Écrit un fichier réel — lecture seule côté fail2ban."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:764
msgid "Exporte les statistiques des logs choisis, avec le même rapport qu'omega-serv et omega-log : synthèse, statuts HTTP, top IP, chemins demandés, chemins en 404, répartition horaire et tendance par jour."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:766
msgid "« Choisir les logs » : cochez un ou plusieurs logs, ceux de la Bibliothèque (5.1) en tête."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:767
msgid "Choisissez une période (24h, 7j, 30j ou tout le fichier) : le rapport s'affiche, puis « Exporter JSON » ou « Exporter HTML » (thème au choix) l'écrit dans le dossier d'exports, visible en 6.6."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:769
msgid "Lecture seule sur les logs. Écrit seulement le fichier d'export."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:770
msgid "Logs seulement : les bans, les jails et l'état du pare-feu sont dans les rapports 8.3 et 8.4. 5.10 reste la vue rapide."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:774
msgid "Liste tous les fichiers exportés (dossier d'exports, et exports de blacklist de 6.1) : type, date, taille — sans ouvrir de terminal ni de gestionnaire de fichiers."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:776
msgid "« Ouvrir » : un rapport HTML s'ouvre dans votre navigateur ; un JSON ou TXT se lit dans omega-fire (lecteur Classique)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:777
msgid "« Copier le chemin » copie le chemin complet du fichier ; « Supprimer » l'efface après confirmation."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:779
msgid "Ouvrir et copier sont en lecture seule. Supprimer efface réellement le fichier."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:781
msgid "omega-fire tourne en root : le navigateur est lancé au nom de l'utilisateur qui a fait sudo, dans sa session graphique. Si le fichier ne lui est pas lisible, une copie lui appartenant est ouverte depuis un dossier temporaire."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:782
msgid "Sans session graphique (connexion SSH, serveur sans bureau), aucun navigateur ne peut s'ouvrir : le chemin du fichier est affiché pour l'ouvrir depuis un autre poste."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:793
msgid "Gestion de l'état interne d'Omega-Fire : sauvegarde/restauration complète (règles + IPs bannies), historique d'audit, rechargement de la configuration."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:797
msgid "Distinct du menu 5 (qui gère les fichiers de logs) — ici, c'est l'état du firewall/fail2ban lui-même qui est sauvegardé/restauré."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:801
msgid "Capture un instantané (snapshot) complet de l'état actuel : règles firewall et IPs bannies (nftables/iptables/fail2ban)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:802
msgid "Une description optionnelle peut être ajoutée pour identifier facilement le snapshot plus tard."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:803
msgid "Crée une archive réelle — n'affecte aucun état actuel, uniquement une sauvegarde."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:807
msgid "Restaure un snapshot précédemment sauvegardé (menu 7.1)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:808
msgid "Sélectionne le snapshot à restaurer dans la liste paginée, puis confirme."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:810
msgid "Les règles firewall actuellement gérées par Omega-Fire sont RETIRÉES puis REMPLACÉES par celles du snapshot."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:812
msgid "Seules les règles que le snapshot peut recréer à l'identique sont réappliquées (chaîne de base, avec seulement protocole, port, adresses, commentaire et verdict). Les autres — règles d'autres outils ou avec des critères qu'Omega-Fire ne sait pas reproduire (état de connexion, interface, type ICMP, limite de débit) — restent telles quelles dans le pare-feu."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:813
msgid "Un snapshot créé avant la version 3.5 ne porte pas cette information : sa restauration ne touche à aucune règle, seules les IPs bannies sont ajoutées."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:814
msgid "La politique par défaut des chaînes n'est remise à ACCEPT que sur un backend où un profil (3.4) était actif."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:815
msgid "Les IPs bannies du snapshot sont AJOUTÉES — rien n'est retiré des bannissements actuels."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:817
msgid "Les jails fail2ban ne sont PAS restaurées automatiquement (information seulement)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:819
msgid "Les règles/IPs gérées par d'autres outils (UFW, etc.) ne sont jamais touchées."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:822
msgid "Opération significative sur les règles firewall — vérifie bien le snapshot choisi avant de confirmer."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:826
msgid "Consulte ou purge l'historique d'audit (le journal des actions effectuées par Omega-Fire, avec succès/échec) — distinct du journal applicatif technique (1.5)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:827
msgid "Recherche par mot-clé possible. Le sous-menu de gestion permet de purger les entrées anciennes."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:828
msgid "La consultation est en lecture seule. La purge supprime réellement des entrées, irréversible."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:832
msgid "Recharge la configuration système sans redémarrer l'application."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:833
msgid "Aucune saisie — lance directement le rechargement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:835
msgid "Même mécanisme que 1.3 (re-scan complet des sondes système et de la configuration), avec un affichage minimal plutôt que le détail diagnostic complet."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:847
msgid "Vue d'ensemble de l'activité réseau en temps réel et sur la durée : tableau de bord live, connexions actives, tendances 7/30 jours."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:851
msgid "Tableau de bord en temps réel combinant statistiques firewall, monitoring, audit et logs — rafraîchi automatiquement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:852
msgid "Aucune saisie au lancement — consulte l'écran, quitte avec la touche indiquée à l'écran."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:857
msgid "Affiche les connexions réseau actives (conntrack) : protocole, état, adresses, ports."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:858
msgid "Filtre par protocole et/ou état une fois la liste initiale affichée, limite le nombre d'entrées affichées."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:863
msgid "Rapport statistique sur les 7 derniers jours (tendances, graphiques)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:869
msgid "Rapport statistique sur les 30 derniers jours — vue macro, même mécanisme que 8.3 avec une fenêtre plus large."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:876
msgid "Visualise en direct les logs serveur (Nginx, Apache, Caddy, Lighttpd) ou le journal applicatif, avec analyse des requêtes HTTP en temps réel. C'est aussi le lecteur « Simple » de 5.2 Favoris et 5.3 Voir les logs."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:882
msgid "Choisis une source épinglée, l'historique récent, ou saisis un chemin/URL manuellement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:885
msgid "Le cadre de gauche montre, comme omega-log : débit, bande passante, statuts HTTP (dont refus 403 et 429), Top 5 IP, chemins demandés, chemins en 404, santé du log."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:886
msgid "Utilise [G] pour gérer les épingles (ajouter/retirer) et l'historique — un [0] Annuler est disponible à chaque étape."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:889
msgid "Lecture seule sur la source suivie — aucune modification du fichier ou du serveur observé."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:891
msgid "Les épingles et l'historique sont persistés (survivent à un redémarrage). Ouvert depuis 5.2 ou 5.3, il démarre directement sur le log choisi, sans toucher à cet historique."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:899
msgid "Sélectionne un ou plusieurs fichiers de logs serveur (Nginx, Apache, Lighttpd, Caddy) pour analyse via lnav — contrairement à 8.5, plusieurs fichiers peuvent être choisis à la fois : lnav les fusionne automatiquement en une seule vue chronologique."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:905
msgid "Numéros séparés par des virgules pour choisir plusieurs sources épinglées/historique à la fois (ex: 1,3)."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:908
msgid "[M] pour un ou plusieurs chemins saisis à la main (mêmes virgules), [G] pour gérer les épingles — un [0]/Entrée annule à chaque étape."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:912
msgid "Lecture seule sur les fichiers sélectionnés — aucune modification."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:914
msgid "Épingles et historique propres à 8.6 (séparés de ceux de 8.5, mêmes mécanismes de stockage). lnav s'ouvre ensuite en plein écran, encapsulé dans un header/footer Omega-Fire — Ctrl-Q pour quitter, Ctrl-C pour copier la ligne courante, la touche t pour changer de thème."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:928
msgid "Ferme Omega-Fire, avec une confirmation avant de quitter réellement."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:929
msgid "Réponds 'o' pour confirmer la fermeture, ou toute autre réponse pour rester dans l'application."
msgstr ""

#: src/omega_fire/interfaces/cli/help_text.py:930
msgid "Aucune sauvegarde automatique n'est déclenchée par cette confirmation — pense à utiliser 7.1 avant de quitter si tu veux capturer l'état actuel."
msgstr ""

