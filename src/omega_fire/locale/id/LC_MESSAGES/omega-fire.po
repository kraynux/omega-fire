#: src/omega_fire/interfaces/cli/help_text.py:65
msgid ""
"Vue globale des backends détectés (nftables, iptables, fail2ban, systemd...) "
"et de leur état : disponible, dégradé ou manquant. Point de départ pour "
"comprendre pourquoi une fonctionnalité est grisée ailleurs dans le menu."
msgstr ""
"Gambaran umum backend yang terdeteksi (nftables, iptables, fail2ban, "
"systemd...) dan statusnya: tersedia, menurun, atau hilang. Titik awal untuk "
"memahami mengapa suatu fitur tidak aktif di bagian lain menu."

#: src/omega_fire/interfaces/cli/help_text.py:71
msgid ""
"Consulte 1.1 pour la vue d'ensemble, 1.3 si l'état affiché semble périmé "
"(après une installation ou un changement système)."
msgstr ""
"Lihat 1.1 untuk gambaran umum, 1.3 jika status yang ditampilkan tampak usang "
"(setelah instalasi atau perubahan sistem)."

#: src/omega_fire/interfaces/cli/help_text.py:78
msgid ""
"Liste toutes les capacités détectées par le dernier scan système : quels "
"backends/services sont disponibles, dégradés ou manquants."
msgstr ""
"Menampilkan semua kapabilitas yang terdeteksi oleh pemindaian sistem "
"terakhir: backend/layanan mana yang tersedia, menurun, atau hilang."

#: src/omega_fire/interfaces/cli/help_text.py:83
msgid "Aucune saisie requise — affiche directement le registre actuel."
msgstr "Tidak perlu masukan — langsung menampilkan registri saat ini."

#: src/omega_fire/interfaces/cli/help_text.py:84
msgid ""
"Suite omega : omega-serv (instances détectées et en service ; « dégradé » si "
"aucune ne tourne), omega-waf (extra magnet activé dans une instance) et "
"omega-jail (jails installés dans /etc/fail2ban/jail.d)."
msgstr ""
"Suite omega: omega-serv (instans yang terdeteksi dan berjalan; \"menurun\" "
"jika tidak ada yang berjalan), omega-waf (ekstra magnet aktif di sebuah "
"instans) dan omega-jail (jail yang terpasang di /etc/fail2ban/jail.d)."

#: src/omega_fire/interfaces/cli/help_text.py:89
msgid ""
"Lecture seule : ne relance aucun scan, affiche l'état déjà en mémoire (voir "
"1.3 pour rafraîchir)."
msgstr ""
"Hanya baca: tidak menjalankan pemindaian ulang, menampilkan status yang sudah"
" ada di memori (lihat 1.3 untuk menyegarkan)."

#: src/omega_fire/interfaces/cli/help_text.py:93
msgid ""
"Si l'appli vient de démarrer sur une machine où un service a changé d'état "
"entre-temps, l'information peut être obsolète — relance un scan (1.3) si "
"besoin."
msgstr ""
"Jika aplikasi baru saja dimulai di mesin yang layanannya berubah status "
"sementara itu, informasinya mungkin usang — jalankan pemindaian ulang (1.3) "
"bila perlu."

#: src/omega_fire/interfaces/cli/help_text.py:101
msgid ""
"Affiche le détail complet d'une capacité précise (ex: nftables, fail2ban) : "
"statut, raison si dégradée/manquante, informations de diagnostic."
msgstr ""
"Menampilkan detail lengkap satu kapabilitas tertentu (mis.: nftables, "
"fail2ban): status, alasan jika menurun/hilang, informasi diagnostik."

#: src/omega_fire/interfaces/cli/help_text.py:106
msgid ""
"Sélectionne par numéro, ou saisis directement l'identifiant de la capacité "
"(visible via 1.1)."
msgstr ""
"Pilih berdasarkan nomor, atau langsung ketik pengenal kapabilitas (terlihat "
"di 1.1)."

#: src/omega_fire/interfaces/cli/help_text.py:109
#: src/omega_fire/interfaces/cli/help_text.py:138
#: src/omega_fire/interfaces/cli/help_text.py:177
#: src/omega_fire/interfaces/cli/help_text.py:257
#: src/omega_fire/interfaces/cli/help_text.py:578
#: src/omega_fire/interfaces/cli/help_text.py:656
#: src/omega_fire/interfaces/cli/help_text.py:723
#: src/omega_fire/interfaces/cli/help_text.py:840
#: src/omega_fire/interfaces/cli/help_text.py:846
#: src/omega_fire/interfaces/cli/help_text.py:852
#: src/omega_fire/interfaces/cli/help_text.py:858
msgid "Lecture seule."
msgstr "Hanya baca."

#: src/omega_fire/interfaces/cli/help_text.py:114
msgid ""
"Relance les sondes système (nftables, iptables, fail2ban, systemd...) pour "
"mettre à jour le registre des capacités."
msgstr ""
"Menjalankan ulang probe sistem (nftables, iptables, fail2ban, systemd...) "
"untuk memperbarui registri kapabilitas."

#: src/omega_fire/interfaces/cli/help_text.py:117
msgid "Aucune saisie — lance directement le scan."
msgstr "Tidak perlu masukan — pemindaian langsung dimulai."

#: src/omega_fire/interfaces/cli/help_text.py:119
msgid ""
"Met à jour le registre en mémoire — peut changer ce qui est grisé/disponible "
"ailleurs dans les menus. Une capacité redevenue disponible débloque "
"immédiatement les actions qui en dépendent, sans redémarrer l'application."
msgstr ""
"Memperbarui registri di memori — dapat mengubah apa yang tidak aktif/tersedia"
" di menu lain. Kapabilitas yang kembali tersedia langsung membuka tindakan "
"yang bergantung padanya, tanpa memulai ulang aplikasi."

#: src/omega_fire/interfaces/cli/help_text.py:125
msgid ""
"Des erreurs partielles sont possibles (ex: une sonde échoue) sans faire "
"échouer tout le scan — le résumé affiché indique combien d'erreurs ont eu "
"lieu, à vérifier si le nombre de composants disponibles semble anormalement "
"bas."
msgstr ""
"Kesalahan sebagian mungkin terjadi (mis.: satu probe gagal) tanpa "
"menggagalkan seluruh pemindaian — ringkasan yang ditampilkan menunjukkan "
"berapa kesalahan yang terjadi, periksa bila jumlah komponen yang tersedia "
"tampak terlalu rendah."

#: src/omega_fire/interfaces/cli/help_text.py:134
msgid ""
"Affiche les erreurs et dégradations récentes détectées sur le système "
"(capacités manquantes/dégradées et pourquoi)."
msgstr ""
"Menampilkan kesalahan dan penurunan terbaru yang terdeteksi di sistem "
"(kapabilitas hilang/menurun dan alasannya)."

#: src/omega_fire/interfaces/cli/help_text.py:137
#: src/omega_fire/interfaces/cli/help_text.py:722
#: src/omega_fire/interfaces/cli/help_text.py:851
#: src/omega_fire/interfaces/cli/help_text.py:857
msgid "Aucune saisie requise."
msgstr "Tidak perlu isian."

#: src/omega_fire/interfaces/cli/help_text.py:143
msgid ""
"Consulte ou purge le journal interne d'Omega-Fire (actions effectuées, "
"erreurs, avertissements) — pas les logs système (Nginx, auth.log...), voir la"
" section 5 pour ceux-là."
msgstr ""
"Melihat atau membersihkan log internal Omega-Fire (tindakan yang dijalankan, "
"kesalahan, peringatan) — bukan log sistem (Nginx, auth.log...), lihat bagian "
"5 untuk itu."

#: src/omega_fire/interfaces/cli/help_text.py:148
msgid ""
"Mode consultation : choisis un nombre de lignes (50/100/personnalisé), un "
"mot-clé optionnel, puis navigue page par page (Entrée pour continuer, q pour "
"arrêter)."
msgstr ""
"Mode lihat: pilih jumlah baris (50/100/kustom), kata kunci opsional, lalu "
"telusuri per halaman (Enter untuk lanjut, q untuk berhenti)."

#: src/omega_fire/interfaces/cli/help_text.py:151
msgid ""
"Mode gestion/purge : supprime les entrées de plus de 30/120 jours, avant une "
"date précise, ou les N plus anciennes — une confirmation est toujours "
"demandée avant suppression."
msgstr ""
"Mode kelola/bersihkan: menghapus entri yang lebih lama dari 30/120 hari, "
"sebelum tanggal tertentu, atau N entri tertua — konfirmasi selalu diminta "
"sebelum penghapusan."

#: src/omega_fire/interfaces/cli/help_text.py:156
msgid ""
"La consultation est en lecture seule. La purge supprime réellement des "
"entrées du journal, de façon irréversible."
msgstr ""
"Mode lihat hanya baca. Pembersihan benar-benar menghapus entri dari log, "
"secara permanen."

#: src/omega_fire/interfaces/cli/help_text.py:160
msgid ""
"Erreurs et alertes critiques sont mises en évidence par couleur — pour "
"chercher un problème précis, filtre par mot-clé plutôt que de tout parcourir."
msgstr ""
"Kesalahan dan peringatan kritis disorot dengan warna — untuk mencari masalah "
"tertentu, filter dengan kata kunci daripada menelusuri semuanya."

#: src/omega_fire/interfaces/cli/help_text.py:168
msgid ""
"Recherche un mot-clé (IP, nom de backend, message d'erreur...) à la fois dans"
" les diagnostics système et dans le journal applicatif, en une seule requête."
msgstr ""
"Mencari kata kunci (IP, nama backend, pesan kesalahan...) sekaligus di "
"diagnostik sistem dan log aplikasi, dalam satu kueri."

#: src/omega_fire/interfaces/cli/help_text.py:173
msgid ""
"Saisis un mot-clé — la recherche combine automatiquement les deux sources "
"(diagnostics + journal), jusqu'à 15 résultats du journal affichés."
msgstr ""
"Ketik kata kunci — pencarian otomatis menggabungkan kedua sumber (diagnostik "
"+ log), hingga 15 hasil dari log ditampilkan."

#: src/omega_fire/interfaces/cli/help_text.py:182
msgid ""
"Exporte un rapport de l'état système et des diagnostics dans un fichier : "
"JSON (données brutes), HTML (rapport visuel, par défaut) ou TXT (texte brut)."
msgstr ""
"Mengekspor laporan status sistem dan diagnostik ke file: JSON (data mentah), "
"HTML (laporan visual, bawaan), atau TXT (teks biasa)."

#: src/omega_fire/interfaces/cli/help_text.py:187
msgid ""
"Choisis le format, puis valide le chemin de destination proposé ou saisis-en "
"un autre."
msgstr ""
"Pilih format, lalu konfirmasi jalur tujuan yang diusulkan atau ketik jalur "
"lain."

#: src/omega_fire/interfaces/cli/help_text.py:191
msgid ""
"Écrit un fichier réel sur disque (par défaut dans le dossier d'exports) — ne "
"modifie rien côté système."
msgstr ""
"Menulis file nyata ke disk (bawaan di folder ekspor) — tidak mengubah apa pun"
" di sisi sistem."

#: src/omega_fire/interfaces/cli/help_text.py:203
msgid ""
"Gestion unifiée des IPs bannies à travers tous les backends détectés "
"(nftables, iptables, fail2ban) : bannir, débannir, lister, synchroniser, "
"importer/exporter, purger."
msgstr ""
"Pengelolaan terpadu IP yang diblokir di semua backend yang terdeteksi "
"(nftables, iptables, fail2ban): blokir, buka blokir, tampilkan, sinkronkan, "
"impor/ekspor, bersihkan."

#: src/omega_fire/interfaces/cli/help_text.py:208
msgid ""
"La plupart des actions agissent par défaut sur tous les backends disponibles "
"simultanément — cibler un seul backend reste possible mais est pensé pour du "
"diagnostic, pas un usage courant."
msgstr ""
"Sebagian besar tindakan secara bawaan berlaku sekaligus pada semua backend "
"yang tersedia — menargetkan satu backend tetap mungkin tetapi ditujukan untuk"
" diagnostik, bukan penggunaan sehari-hari."

#: src/omega_fire/interfaces/cli/help_text.py:216
msgid ""
"Bannit une seule IP, sur tous les backends détectés par défaut "
"(nftables/iptables/fail2ban)."
msgstr ""
"Memblokir satu IP, secara bawaan di semua backend yang terdeteksi "
"(nftables/iptables/fail2ban)."

#: src/omega_fire/interfaces/cli/help_text.py:218
msgid ""
"Saisis l'IP, choisis les backends cibles (tous par défaut, ou un seul pour "
"diagnostic), ajoute un commentaire optionnel, puis confirme."
msgstr ""
"Ketik IP, pilih backend target (bawaan semua, atau satu untuk diagnostik), "
"tambahkan komentar opsional, lalu konfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:223
msgid ""
"L'IP est bloquée immédiatement sur chaque backend ciblé. Un rapport par "
"backend indique succès, doublon (déjà bannie) ou échec."
msgstr ""
"IP langsung diblokir di setiap backend yang ditargetkan. Laporan per backend "
"menunjukkan berhasil, duplikat (sudah diblokir), atau gagal."

#: src/omega_fire/interfaces/cli/help_text.py:227
msgid ""
"Cibler un seul backend est un mode diagnostic : si un autre backend est "
"actif, l'IP pourrait rester accessible via ce dernier."
msgstr ""
"Menargetkan satu backend adalah mode diagnostik: jika backend lain aktif, IP "
"mungkin tetap dapat diakses melalui backend tersebut."

#: src/omega_fire/interfaces/cli/help_text.py:234
msgid ""
"Bannit une liste d'IPs en une fois, depuis une saisie manuelle ou un fichier "
"(défaut, fichier fail2ban par défaut, dossier var/blocklist/, fichier "
"épinglé, ou chemin personnalisé)."
msgstr ""
"Memblokir daftar IP sekaligus, dari masukan manual atau file (bawaan, file "
"fail2ban bawaan, folder var/blocklist/, file tersemat, atau jalur kustom)."

#: src/omega_fire/interfaces/cli/help_text.py:238
msgid ""
"Choisis la méthode d'approvisionnement, puis valide la liste d'IPs extraite "
"avant le bannissement effectif."
msgstr ""
"Pilih cara pengambilan, lalu konfirmasi daftar IP yang diekstrak sebelum "
"pemblokiran sebenarnya."

#: src/omega_fire/interfaces/cli/help_text.py:239
msgid ""
"Chaque IP valide extraite est bannie sur les backends ciblés, comme pour 2.1 "
"mais en masse."
msgstr ""
"Setiap IP valid yang diekstrak diblokir di backend yang ditargetkan, seperti "
"2.1 tetapi massal."

#: src/omega_fire/interfaces/cli/help_text.py:243
msgid "Débannit une seule IP, sur tous les backends détectés par défaut."
msgstr ""
"Membuka blokir satu IP, secara bawaan di semua backend yang terdeteksi."

#: src/omega_fire/interfaces/cli/help_text.py:244
msgid ""
"Même déroulé que 2.1, en sens inverse : saisis l'IP, choisis les backends, "
"confirme."
msgstr ""
"Alur yang sama seperti 2.1, arah sebaliknya: ketik IP, pilih backend, "
"konfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:245
msgid "L'IP redevient accessible immédiatement sur chaque backend ciblé."
msgstr "IP langsung dapat diakses kembali di setiap backend yang ditargetkan."

#: src/omega_fire/interfaces/cli/help_text.py:249
msgid ""
"Débannit une liste d'IPs en une fois — même logique d'approvisionnement que "
"2.2."
msgstr ""
"Membuka blokir daftar IP sekaligus — cara pengambilan sama seperti 2.2."

#: src/omega_fire/interfaces/cli/help_text.py:250
msgid "Choisis la méthode d'approvisionnement, valide la liste, confirme."
msgstr "Pilih cara pengambilan, konfirmasi daftar, konfirmasi tindakan."

#: src/omega_fire/interfaces/cli/help_text.py:251
msgid "Chaque IP de la liste est débannie sur les backends ciblés."
msgstr "Setiap IP dalam daftar dibuka blokirnya di backend yang ditargetkan."

#: src/omega_fire/interfaces/cli/help_text.py:255
msgid ""
"Liste toutes les IPs actuellement bannies, avec leur backend d'origine et "
"leur commentaire/source."
msgstr ""
"Menampilkan semua IP yang saat ini diblokir, dengan backend asal dan "
"komentar/sumbernya."

#: src/omega_fire/interfaces/cli/help_text.py:256
msgid "Choisis un backend précis ou consulte tous les backends d'un coup."
msgstr "Pilih backend tertentu atau lihat semua backend sekaligus."

#: src/omega_fire/interfaces/cli/help_text.py:261
msgid ""
"Réconcilie les backends entre eux : ajoute sur chaque backend cible les IPs "
"déjà bannies ailleurs mais manquantes chez lui."
msgstr ""
"Menyelaraskan backend satu sama lain: menambahkan ke setiap backend target IP"
" yang sudah diblokir di tempat lain tetapi belum ada di backend tersebut."

#: src/omega_fire/interfaces/cli/help_text.py:262
msgid "Choisis les backends à synchroniser (tous par défaut)."
msgstr "Pilih backend yang akan disinkronkan (bawaan semua)."

#: src/omega_fire/interfaces/cli/help_text.py:263
msgid ""
"Additif uniquement : ne retire jamais une IP, ajoute seulement celles "
"manquantes pour aligner les backends."
msgstr ""
"Hanya menambah: tidak pernah menghapus IP, hanya menambahkan yang belum ada "
"agar backend selaras."

#: src/omega_fire/interfaces/cli/help_text.py:268
msgid ""
"Gestion complète des fichiers de blocklist dans var/blocklist/ : créer, "
"importer depuis un autre dossier, éditer IP par IP, renommer, supprimer, et "
"bannir directement le contenu d'un fichier."
msgstr ""
"Pengelolaan lengkap file blocklist di var/blocklist/: buat, impor dari folder"
" lain, sunting per IP, ganti nama, hapus, dan blokir langsung isi suatu file."

#: src/omega_fire/interfaces/cli/help_text.py:272
msgid ""
"Sélectionne un fichier existant pour l'éditer, ou utilise [I]/[N] pour en "
"importer/créer un nouveau."
msgstr ""
"Pilih file yang ada untuk disunting, atau gunakan [I]/[N] untuk "
"mengimpor/membuat yang baru."

#: src/omega_fire/interfaces/cli/help_text.py:274
msgid ""
"Les modifications (ajout/retrait d'IP, renommage, suppression) touchent le "
"fichier réel sur disque — bannir depuis un fichier ici bannit réellement les "
"IPs valides qu'il contient."
msgstr ""
"Perubahan (tambah/hapus IP, ganti nama, hapus) mengenai file nyata di disk — "
"memblokir dari file di sini benar-benar memblokir IP valid di dalamnya."

#: src/omega_fire/interfaces/cli/help_text.py:281
msgid ""
"Exporte les IPs actuellement bannies vers un fichier (défaut, backup "
"horodaté, fichier existant, récent, chemin manuel, ou fichier épinglé)."
msgstr ""
"Mengekspor IP yang saat ini diblokir ke file (bawaan, cadangan berstempel "
"waktu, file yang ada, terbaru, jalur manual, atau file tersemat)."

#: src/omega_fire/interfaces/cli/help_text.py:282
msgid ""
"Choisis la destination et le mode d'écriture (écraser ou ajouter au fichier "
"existant)."
msgstr ""
"Pilih tujuan dan mode penulisan (timpa atau tambahkan ke file yang ada)."

#: src/omega_fire/interfaces/cli/help_text.py:283
msgid "Écrit un fichier réel — ne modifie aucun état de bannissement."
msgstr "Menulis file nyata — tidak mengubah status blokir apa pun."

#: src/omega_fire/interfaces/cli/help_text.py:287
msgid ""
"PURGE : débannit toutes les IPs sur les backends ciblés (tous par défaut)."
msgstr ""
"BERSIHKAN: membuka blokir semua IP di backend yang ditargetkan (bawaan "
"semua)."

#: src/omega_fire/interfaces/cli/help_text.py:288
msgid "Une confirmation explicite est demandée avant exécution."
msgstr "Konfirmasi eksplisit diminta sebelum eksekusi."

#: src/omega_fire/interfaces/cli/help_text.py:290
msgid ""
"Toutes les IPs actuellement bannies sur les backends ciblés sont débannies. "
"Les règles de filtrage principales (ports autorisés, accès SSH...) restent "
"intactes — seule la liste des IPs bannies est vidée."
msgstr ""
"Semua IP yang saat ini diblokir di backend yang ditargetkan dibuka blokirnya."
" Aturan penyaringan utama (port yang diizinkan, akses SSH...) tetap utuh — "
"hanya daftar IP yang diblokir yang dikosongkan."

#: src/omega_fire/interfaces/cli/help_text.py:295
msgid ""
"Cibler un seul backend est un mode diagnostic — une IP bannie ailleurs "
"resterait bloquée malgré cette purge."
msgstr ""
"Menargetkan satu backend adalah mode diagnostik — IP yang diblokir di tempat "
"lain tetap terblokir meskipun dibersihkan di sini."

#: src/omega_fire/interfaces/cli/help_text.py:300
msgid ""
"Transfère des IPs entre jails fail2ban, vers/depuis les backends firewall "
"(nftables/iptables), ou depuis/vers des fichiers — raccourci vers la même "
"action que 4.3, accessible directement depuis la section IPs."
msgstr ""
"Memindahkan IP antar jail fail2ban, ke/dari backend firewall "
"(nftables/iptables), atau dari/ke file — pintasan ke tindakan yang sama "
"seperti 4.3, dapat diakses langsung dari bagian IP."

#: src/omega_fire/interfaces/cli/help_text.py:306
#: src/omega_fire/interfaces/cli/help_text.py:485
msgid ""
"Choisis d'abord une source (un jail, un backend, un fichier), puis une "
"destination."
msgstr "Pilih sumber terlebih dahulu (jail, backend, file), lalu tujuan."

#: src/omega_fire/interfaces/cli/help_text.py:308
#: src/omega_fire/interfaces/cli/help_text.py:487
msgid ""
"Un récapitulatif (IPs déjà présentes / nouvelles / échecs) s'affiche après "
"l'opération — vérifie-le avant de continuer."
msgstr ""
"Ringkasan (IP sudah ada / baru / gagal) ditampilkan setelah operasi — periksa"
" sebelum melanjutkan."

#: src/omega_fire/interfaces/cli/help_text.py:312
#: src/omega_fire/interfaces/cli/help_text.py:491
msgid ""
"Les IPs transférées vers un jail ou un backend sont réellement bannies à la "
"destination, pas juste copiées dans une liste."
msgstr ""
"IP yang dipindahkan ke jail atau backend benar-benar diblokir di tujuan, "
"tidak hanya disalin ke daftar."

#: src/omega_fire/interfaces/cli/help_text.py:316
#: src/omega_fire/interfaces/cli/help_text.py:495
msgid ""
"Le transfert vers nftables crée automatiquement la chaîne de blocage si elle "
"n'existe pas encore — normal, pas une erreur si tu la vois apparaître pour la"
" première fois."
msgstr ""
"Pemindahan ke nftables otomatis membuat rantai pemblokiran jika belum ada — "
"ini normal, bukan kesalahan jika Anda melihatnya muncul pertama kali."

#: src/omega_fire/interfaces/cli/help_text.py:328
msgid ""
"Gestion fine des règles de pare-feu (ports, protocoles, réseaux) sur "
"nftables/iptables, indépendamment du bannissement d'IP (section 2)."
msgstr ""
"Pengelolaan rinci aturan firewall (port, protokol, jaringan) di "
"nftables/iptables, terpisah dari pemblokiran IP (bagian 2)."

#: src/omega_fire/interfaces/cli/help_text.py:330
msgid ""
"Une règle est en général créée sur les deux backends disponibles "
"simultanément — un profil restrictif actif sur un seul backend peut annuler "
"l'effet d'une règle posée sur l'autre (voir 3.1)."
msgstr ""
"Aturan biasanya dibuat sekaligus di kedua backend yang tersedia — profil "
"ketat yang aktif hanya di satu backend dapat meniadakan efek aturan yang "
"dipasang di backend lainnya (lihat 3.1)."

#: src/omega_fire/interfaces/cli/help_text.py:338
msgid ""
"Assistant pas-à-pas pour créer une règle avancée (source, port, protocole, "
"action) sur un ou plusieurs backends."
msgstr ""
"Asisten langkah demi langkah untuk membuat aturan lanjutan (sumber, port, "
"protokol, tindakan) di satu atau beberapa backend."

#: src/omega_fire/interfaces/cli/help_text.py:339
msgid ""
"Réponds aux questions successives : backend(s) cible(s), puis les paramètres "
"de la règle."
msgstr ""
"Jawab pertanyaan secara berurutan: backend target, lalu parameter aturan."

#: src/omega_fire/interfaces/cli/help_text.py:340
msgid ""
"La règle est appliquée immédiatement sur les backends ciblés et enregistrée "
"en base pour réapparaître dans 3.2/3.3."
msgstr ""
"Aturan langsung diterapkan di backend yang ditargetkan dan disimpan di basis "
"data agar muncul kembali di 3.2/3.3."

#: src/omega_fire/interfaces/cli/help_text.py:342
msgid ""
"Deux backends actifs au même point de contrôle fonctionnent en INTERSECTION, "
"pas en union : créer une règle ACCEPT sur un seul backend ne suffit pas si "
"l'autre bloque toujours ce trafic — il reste refusé tant que les deux ne "
"l'autorisent pas. Cibler un seul backend est réservé au diagnostic."
msgstr ""
"Dua backend yang aktif pada titik kontrol yang sama bekerja sebagai IRISAN, "
"bukan gabungan: membuat aturan ACCEPT di satu backend tidak cukup jika "
"backend lainnya masih memblokir lalu lintas tersebut — lalu lintas tetap "
"ditolak sampai keduanya mengizinkannya. Menargetkan satu backend hanya untuk "
"diagnostik."

#: src/omega_fire/interfaces/cli/help_text.py:351
msgid ""
"Supprime une ou plusieurs règles, sélectionnées par ID (règles Omega-Fire "
"créées via 3.1, règles système importées, ou les deux) — ou nettoie en un "
"clic toutes les règles INACTIVES."
msgstr ""
"Menghapus satu atau beberapa aturan, dipilih berdasarkan ID (aturan Omega-"
"Fire yang dibuat melalui 3.1, aturan sistem yang diimpor, atau keduanya) — "
"atau membersihkan semua aturan TIDAK AKTIF dalam satu klik."

#: src/omega_fire/interfaces/cli/help_text.py:353
msgid ""
"Filtre l'affichage (Omega-Fire / Système / Toutes), puis saisis un ou "
"plusieurs IDs séparés par une virgule."
msgstr ""
"Filter tampilan (Omega-Fire / Sistem / Semua), lalu ketik satu atau beberapa "
"ID dipisahkan koma."

#: src/omega_fire/interfaces/cli/help_text.py:354
msgid ""
"Si des règles inactives existent, une option [4] apparaît pour toutes les "
"supprimer d'un coup (une seule confirmation, sans sélection ID par ID) — "
"utile quand la majorité des règles importées du système sont inactives."
msgstr ""
"Jika ada aturan tidak aktif, opsi [4] muncul untuk menghapus semuanya "
"sekaligus (satu konfirmasi, tanpa memilih per ID) — berguna bila sebagian "
"besar aturan sistem yang diimpor tidak aktif."

#: src/omega_fire/interfaces/cli/help_text.py:355
msgid ""
"« Nettoyer et resynchroniser la base » : remet la liste des règles d'accord "
"avec ce que le pare-feu contient vraiment. Un aperçu s'affiche d'abord "
"(lignes gardées, doublons, lignes absentes du noyau, lignes d'un backend "
"absent de la machine, règles du noyau à importer) ; les lignes qui seront "
"retirées apparaissent dans le tableau."
msgstr ""
"\"Bersihkan dan sinkronkan ulang basis data\": menyelaraskan kembali daftar "
"aturan dengan isi firewall yang sebenarnya. Pratinjau ditampilkan lebih dulu "
"(baris yang dipertahankan, duplikat, baris yang tidak ada di kernel, baris "
"backend yang tidak ada di mesin, aturan kernel yang akan diimpor); baris yang"
" akan dihapus tampil di tabel."

#: src/omega_fire/interfaces/cli/help_text.py:358
msgid ""
"Suppression réelle et immédiate sur le(s) backend(s) où la règle est active."
msgstr "Penghapusan nyata dan langsung di backend tempat aturan aktif."

#: src/omega_fire/interfaces/cli/help_text.py:359
msgid ""
"Nettoyer et resynchroniser : seule la base d'Omega-Fire change, aucune règle "
"n'est ajoutée ni retirée du pare-feu. La base est sauvegardée avant, dans "
"var/backups/db/."
msgstr ""
"Bersihkan dan sinkronkan ulang: hanya basis data Omega-Fire yang berubah, "
"tidak ada aturan yang ditambahkan ke atau dihapus dari firewall. Basis data "
"dicadangkan lebih dulu di var/backups/db/."

#: src/omega_fire/interfaces/cli/help_text.py:362
msgid ""
"Les règles système importées (déjà présentes avant Omega-Fire) peuvent être "
"supprimées ici aussi — vérifie l'origine affichée avant de confirmer."
msgstr ""
"Aturan sistem yang diimpor (sudah ada sebelum Omega-Fire) juga dapat dihapus "
"di sini — periksa asal yang ditampilkan sebelum mengonfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:363
msgid ""
"Une règle posée par un autre outil (UFW, Tailscale, Docker…, nom affiché dans"
" la colonne Origine) n'est pas supprimée ici : elle se gère avec son outil, "
"qui la recréerait ou deviendrait incohérent."
msgstr ""
"Aturan yang dipasang alat lain (UFW, Tailscale, Docker…, nama tampil di kolom"
" Asal) tidak dihapus di sini: kelola dengan alat tersebut, yang akan "
"membuatnya lagi atau menjadi tidak konsisten."

#: src/omega_fire/interfaces/cli/help_text.py:364
msgid ""
"Nettoyer et resynchroniser : un backend illisible (droits, erreur) n'est "
"jamais touché ; un backend dont la commande est absente de la machine voit "
"ses lignes retirées."
msgstr ""
"Bersihkan dan sinkronkan ulang: backend yang tidak terbaca (izin, galat) "
"tidak pernah disentuh; backend yang perintahnya tidak ada di mesin akan "
"dihapus barisnya."

#: src/omega_fire/interfaces/cli/help_text.py:369
msgid "Liste toutes les règles détaillées, avec compteurs par backend."
msgstr "Menampilkan semua aturan secara rinci, dengan penghitung per backend."

#: src/omega_fire/interfaces/cli/help_text.py:370
msgid ""
"Aucune saisie — une synchronisation depuis les backends actifs est faite "
"automatiquement avant l'affichage."
msgstr ""
"Tidak perlu masukan — sinkronisasi dari backend yang aktif dilakukan otomatis"
" sebelum ditampilkan."

#: src/omega_fire/interfaces/cli/help_text.py:372
msgid ""
"Lecture seule, mais met à jour la base locale de règles avec l'état réel du "
"noyau avant de l'afficher — ce que tu vois reflète toujours l'état courant, "
"pas un instantané périmé."
msgstr ""
"Hanya baca, tetapi memperbarui basis data aturan lokal dengan status kernel "
"yang sebenarnya sebelum menampilkannya — yang Anda lihat selalu mencerminkan "
"status terkini, bukan potret usang."

#: src/omega_fire/interfaces/cli/help_text.py:375
msgid ""
"Colonne Origine : OMEGA (créée par Omega-Fire), SYSTEME (présente avant, ou "
"ajoutée à la main), ou le nom de l'outil qui l'a posée (UFW, Tailscale, "
"Docker, Fail2Ban, firewalld…). Les règles d'autres outils sont affichées pour"
" information : Omega-Fire ne les modifie pas."
msgstr ""
"Kolom Asal: OMEGA (dibuat oleh Omega-Fire), SYSTEM (sudah ada sebelumnya atau"
" ditambahkan manual), atau nama alat yang memasangnya (UFW, Tailscale, "
"Docker, Fail2Ban, firewalld…). Aturan alat lain ditampilkan sebagai "
"informasi: Omega-Fire tidak mengubahnya."

#: src/omega_fire/interfaces/cli/help_text.py:380
msgid ""
"Applique un profil de sécurité pré-défini (politique complète de règles) sur "
"les backends disponibles."
msgstr ""
"Menerapkan profil keamanan yang telah ditentukan (kebijakan aturan lengkap) "
"ke backend yang tersedia."

#: src/omega_fire/interfaces/cli/help_text.py:382
msgid ""
"L'état du profil actuellement actif (le cas échéant) est affiché avant de "
"proposer les profils disponibles."
msgstr ""
"Status profil yang sedang aktif (jika ada) ditampilkan sebelum profil yang "
"tersedia ditawarkan."

#: src/omega_fire/interfaces/cli/help_text.py:383
msgid ""
"Si des règles d'autres outils (UFW, Tailscale, Docker…) sont présentes sur "
"iptables / ip6tables, tu choisis : appliquer sur tous les backends, appliquer"
" seulement sur nftables, ou annuler. Le message indique combien de règles de "
"chaque outil sont concernées."
msgstr ""
"Jika ada aturan alat lain (UFW, Tailscale, Docker…) di iptables / ip6tables, "
"Anda memilih: terapkan di semua backend, terapkan hanya di nftables, atau "
"batal. Pesan menunjukkan berapa aturan dari tiap alat yang terdampak."

#: src/omega_fire/interfaces/cli/help_text.py:386
msgid ""
"Remplace la politique de filtrage active par celle du profil choisi, sur tous"
" les backends disponibles en même temps (nftables, iptables, ip6tables)."
msgstr ""
"Mengganti kebijakan penyaringan aktif dengan kebijakan profil yang dipilih, "
"di semua backend yang tersedia sekaligus (nftables, iptables, ip6tables)."

#: src/omega_fire/interfaces/cli/help_text.py:387
msgid ""
"Réappliquer le même profil ne crée pas de doublons : chaque backend est vidé "
"puis reconstruit, et la base d'Omega-Fire est remise d'accord avec lui."
msgstr ""
"Menerapkan ulang profil yang sama tidak membuat duplikat: setiap backend "
"dikosongkan lalu dibangun ulang, dan basis data Omega-Fire diselaraskan "
"kembali dengannya."

#: src/omega_fire/interfaces/cli/help_text.py:388
msgid ""
"nftables : seule la table d'Omega-Fire (inet filter) est vidée ; les tables "
"des autres outils ne sont pas touchées."
msgstr ""
"nftables: hanya tabel Omega-Fire (inet filter) yang dikosongkan; tabel alat "
"lain tidak disentuh."

#: src/omega_fire/interfaces/cli/help_text.py:389
msgid ""
"iptables / ip6tables : toute la table filter est vidée (iptables -F, -X), y "
"compris les chaînes et les règles des autres outils (ufw-*, ts-*…). La "
"politique par défaut d'INPUT / OUTPUT / FORWARD devient celle du profil."
msgstr ""
"iptables / ip6tables: seluruh tabel filter dikosongkan (iptables -F, -X), "
"termasuk rantai dan aturan alat lain (ufw-*, ts-*…). Kebijakan bawaan INPUT /"
" OUTPUT / FORWARD menjadi kebijakan profil."

#: src/omega_fire/interfaces/cli/help_text.py:390
msgid ""
"Une sauvegarde automatique (snapshot) est tentée avant application ; 7.2 peut"
" la restaurer."
msgstr ""
"Pencadangan otomatis (snapshot) dicoba sebelum penerapan; 7.2 dapat "
"memulihkannya."

#: src/omega_fire/interfaces/cli/help_text.py:393
msgid ""
"Tous les backends, avec UFW ou Tailscale : leurs règles disparaissent du "
"noyau jusqu'au prochain rechargement de l'outil (« ufw reload », redémarrage "
"du service Tailscale ou de la machine). Entre-temps, seul le profil d'Omega-"
"Fire protège la machine — et un accès autorisé par UFW (ex. Samba, VNC "
"limités au réseau local) peut être bloqué."
msgstr ""
"Semua backend, dengan UFW atau Tailscale: aturannya hilang dari kernel sampai"
" alat dimuat ulang berikutnya (\"ufw reload\", mulai ulang layanan Tailscale "
"atau mesin). Selama itu, hanya profil Omega-Fire yang melindungi mesin — dan "
"akses yang diizinkan UFW (mis. Samba, VNC yang dibatasi ke jaringan lokal) "
"bisa diblokir."

#: src/omega_fire/interfaces/cli/help_text.py:394
msgid ""
"Seulement nftables : les règles des autres outils restent en place. Les deux "
"pare-feu s'appliquent alors ensemble : un paquet doit être accepté par les "
"deux. Un profil strict peut bloquer un accès qu'UFW autorise, et inversement."
msgstr ""
"Hanya nftables: aturan alat lain tetap di tempatnya. Kedua firewall lalu "
"berlaku bersama: sebuah paket harus diterima oleh keduanya. Profil yang ketat"
" bisa memblokir akses yang diizinkan UFW, dan sebaliknya."

#: src/omega_fire/interfaces/cli/help_text.py:395
msgid ""
"La restauration 7.2 d'un snapshot ne repose pas les règles des autres outils "
": c'est à l'outil lui-même de les recréer."
msgstr ""
"Memulihkan snapshot dengan 7.2 tidak memasang kembali aturan alat lain: alat "
"itu sendiri yang harus membuatnya ulang."

#: src/omega_fire/interfaces/cli/help_text.py:400
msgid ""
"Gestion des tables : diagnostic des tables et des politiques, initialisation "
"de la table nftables d'Omega-Fire, remise des politiques à ACCEPT, vidage "
"d'un backend ou de tous, suppression de la table nftables (avancé)."
msgstr ""
"Manajemen tabel: diagnosis tabel dan kebijakan, inisialisasi tabel nftables "
"Omega-Fire, atur ulang kebijakan ke ACCEPT, kosongkan satu atau semua "
"backend, hapus tabel nftables (lanjutan)."

#: src/omega_fire/interfaces/cli/help_text.py:402
msgid ""
"Le diagnostic s'affiche toujours en haut ; choisis ensuite l'action, et le "
"backend quand elle en demande un."
msgstr ""
"Diagnosis selalu tampil di bagian atas; lalu pilih tindakan, dan backend bila"
" tindakan memintanya."

#: src/omega_fire/interfaces/cli/help_text.py:403
msgid ""
"Politiques différentes selon les backends : le noyau fait passer chaque "
"paquet par toutes les chaînes branchées au même endroit (table nftables "
"d'Omega-Fire et tables d'UFW via iptables-nft) ; un paquet doit être accepté "
"par chacune, la politique la plus stricte l'emporte. « nftables ACCEPT, "
"iptables DROP » n'ouvre donc rien : c'est iptables qui décide."
msgstr ""
"Kebijakan berbeda antar-backend: kernel melewatkan setiap paket melalui semua"
" rantai yang terkait di titik yang sama (tabel nftables Omega-Fire dan tabel "
"UFW melalui iptables-nft); paket harus diterima oleh masing-masing, kebijakan"
" paling ketat yang berlaku. Jadi \"nftables ACCEPT, iptables DROP\" tidak "
"membuka apa pun: iptables yang menentukan."

#: src/omega_fire/interfaces/cli/help_text.py:404
msgid ""
"Pour chaque politique DROP, la cause est indiquée : outil qui l'a posée "
"(UFW…, rien à faire), profil Omega-Fire actif (rien à faire), politique "
"orpheline sans aucune règle (affichée en jaune : tout est bloqué sur ce "
"backend, remède « Remettre les politiques à ACCEPT » ou appliquer un profil),"
" ou politique DROP avec des règles mais sans profil (vérifier en 3.3)."
msgstr ""
"Untuk setiap kebijakan DROP, penyebabnya ditampilkan: alat yang menetapkannya"
" (UFW…, tidak perlu tindakan), profil Omega-Fire aktif (tidak perlu "
"tindakan), kebijakan yatim tanpa aturan apa pun (tampil kuning: semuanya "
"diblokir di backend ini, solusinya \"Atur ulang kebijakan ke ACCEPT\" atau "
"terapkan profil), atau kebijakan DROP dengan aturan tetapi tanpa profil "
"(periksa di 3.3)."

#: src/omega_fire/interfaces/cli/help_text.py:405
msgid ""
"Initialiser la table nftables crée ses chaînes en ACCEPT : sur une machine "
"filtrée par UFW, une différence de politique apparaît alors, c'est normal."
msgstr ""
"Inisialisasi tabel nftables membuat rantainya dengan ACCEPT: di mesin yang "
"disaring UFW, perbedaan kebijakan lalu muncul, ini normal."

#: src/omega_fire/interfaces/cli/help_text.py:406
msgid ""
"Si des règles d'autres outils (UFW, Tailscale, Docker…) sont présentes sur "
"iptables / ip6tables, la confirmation l'indique, avec le nombre de règles par"
" outil ; pour « vider tous les backends », tu peux choisir de ne vider que "
"nftables."
msgstr ""
"Jika ada aturan alat lain (UFW, Tailscale, Docker…) di iptables / ip6tables, "
"konfirmasi menyebutkannya beserta jumlah aturan per alat; untuk \"kosongkan "
"semua backend\", Anda bisa memilih mengosongkan nftables saja."

#: src/omega_fire/interfaces/cli/help_text.py:409
msgid "Vider nftables : seule la table d'Omega-Fire est vidée."
msgstr "Kosongkan nftables: hanya tabel Omega-Fire yang dikosongkan."

#: src/omega_fire/interfaces/cli/help_text.py:410
msgid ""
"Vider iptables / ip6tables : toute la table filter est vidée (iptables -F), "
"règles des autres outils comprises ; leurs chaînes restent, vides. La "
"politique par défaut ne change pas."
msgstr ""
"Kosongkan iptables / ip6tables: seluruh tabel filter dikosongkan (iptables "
"-F), termasuk aturan alat lain; rantainya tetap ada, kosong. Kebijakan bawaan"
" tidak berubah."

#: src/omega_fire/interfaces/cli/help_text.py:411
msgid ""
"Remettre les politiques à ACCEPT : input, output et forward acceptent tout "
"paquet qu'aucune règle ne bloque explicitement."
msgstr ""
"Atur ulang kebijakan ke ACCEPT: input, output, dan forward menerima setiap "
"paket yang tidak diblokir secara eksplisit oleh aturan mana pun."

#: src/omega_fire/interfaces/cli/help_text.py:414
msgid ""
"Vider iptables avec UFW : si la politique d'INPUT est DROP (cas d'UFW), plus "
"aucun paquet entrant n'est accepté sur ce backend, connexions déjà ouvertes "
"comprises — risque de perdre un accès distant (SSH). « ufw reload » repose "
"les règles d'UFW."
msgstr ""
"Mengosongkan iptables saat ada UFW: jika kebijakan INPUT adalah DROP (kasus "
"UFW), tidak ada lagi paket masuk yang diterima di backend ini, termasuk "
"koneksi yang sudah terbuka — risiko kehilangan akses jarak jauh (SSH). \"ufw "
"reload\" memasang kembali aturan UFW."

#: src/omega_fire/interfaces/cli/help_text.py:415
msgid ""
"Remettre les politiques à ACCEPT avec UFW : UFW compte sur INPUT en DROP ; à "
"ACCEPT, la machine accepte tout ce qu'UFW n'interdit pas explicitement. « ufw"
" reload » rétablit sa politique."
msgstr ""
"Mengatur ulang kebijakan ke ACCEPT saat ada UFW: UFW mengandalkan INPUT pada "
"DROP; dengan ACCEPT, mesin menerima semua yang tidak dilarang UFW secara "
"eksplisit. \"ufw reload\" memulihkan kebijakannya."

#: src/omega_fire/interfaces/cli/help_text.py:416
msgid ""
"Les deux actions combinées (vider puis ACCEPT) laissent la machine sans aucun"
" filtrage sur ce backend."
msgstr ""
"Kedua tindakan digabung (kosongkan lalu ACCEPT) membuat mesin tanpa "
"penyaringan sama sekali di backend ini."

#: src/omega_fire/interfaces/cli/help_text.py:427
msgid ""
"Gestion complète du démon fail2ban : consulter l'état des jails, "
"bannir/débannir des IPs, transférer des IPs entre jails ou vers les backends "
"firewall, créer/supprimer/vider des jails, exporter, vérifier la "
"configuration, piloter le service."
msgstr ""
"Pengelolaan lengkap daemon fail2ban: melihat status jail, memblokir/membuka "
"blokir IP, memindahkan IP antar jail atau ke backend firewall, "
"membuat/menghapus/mengosongkan jail, mengekspor, memeriksa konfigurasi, "
"mengendalikan layanan."

#: src/omega_fire/interfaces/cli/help_text.py:433
msgid "Nécessite fail2ban installé et fail2ban-client accessible."
msgstr "Memerlukan fail2ban terpasang dan fail2ban-client dapat diakses."

#: src/omega_fire/interfaces/cli/help_text.py:434
msgid ""
"Chaque sous-menu agit sur un jail précis ou sur l'ensemble des jails — "
"vérifie bien le nom du jail affiché avant de valider une action large (Vider "
"un jail, Vider tous les jails)."
msgstr ""
"Setiap submenu bekerja pada jail tertentu atau pada semua jail — periksa "
"baik-baik nama jail yang ditampilkan sebelum mengonfirmasi tindakan luas "
"(Kosongkan jail, Kosongkan semua jail)."

#: src/omega_fire/interfaces/cli/help_text.py:442
msgid ""
"Affiche un tableau récapitulatif de tous les jails configurés (nom, statut, "
"nombre d'IPs bannies) puis propose un sous-menu d'analyse : lister les IPs "
"d'un jail, de tous les jails, ou rechercher dans quel(s) jail(s) une IP "
"précise est bannie."
msgstr ""
"Menampilkan tabel ringkasan semua jail yang dikonfigurasi (nama, status, "
"jumlah IP diblokir) lalu menawarkan submenu analisis: tampilkan IP satu jail,"
" semua jail, atau cari di jail mana suatu IP diblokir."

#: src/omega_fire/interfaces/cli/help_text.py:448
msgid ""
"Le scan est lancé automatiquement à l'ouverture. Ensuite, choisis [1] pour un"
" jail précis (par son numéro dans le tableau), [2] pour tout lister, ou [3] "
"pour rechercher une IP spécifique."
msgstr ""
"Pemindaian dijalankan otomatis saat dibuka. Kemudian pilih [1] untuk jail "
"tertentu (berdasarkan nomornya di tabel), [2] untuk menampilkan semuanya, "
"atau [3] untuk mencari IP tertentu."

#: src/omega_fire/interfaces/cli/help_text.py:452
msgid ""
"Lecture seule : ne modifie rien. La colonne Origine indique qui a défini le "
"jail : Omega-Fire (4.4), omega-jail, la configuration principale de fail2ban "
"(jail.local / jail.conf) ou un autre fichier."
msgstr ""
"Hanya baca: tidak mengubah apa pun. Kolom Asal menunjukkan siapa yang "
"mendefinisikan jail: Omega-Fire (4.4), omega-jail, konfigurasi utama fail2ban"
" (jail.local / jail.conf) atau file lain."

#: src/omega_fire/interfaces/cli/help_text.py:454
msgid ""
"Lit directement la base de données de fail2ban et les fichiers de "
"configuration pour rester rapide même avec beaucoup de jails, plutôt que "
"d'interroger fail2ban-client un par un."
msgstr ""
"Membaca langsung basis data fail2ban dan file konfigurasi agar tetap cepat "
"walau ada banyak jail, alih-alih menanyai fail2ban-client satu per satu."

#: src/omega_fire/interfaces/cli/help_text.py:461
msgid ""
"Bannit ou débannit une ou plusieurs IPs dans un jail précis que tu choisis."
msgstr ""
"Memblokir atau membuka blokir satu atau beberapa IP di jail tertentu yang "
"Anda pilih."

#: src/omega_fire/interfaces/cli/help_text.py:463
msgid ""
"Sélectionne d'abord le jail cible, puis l'action (bannir/débannir), puis "
"saisis une IP unique ou une liste."
msgstr ""
"Pilih dulu jail target, lalu tindakannya (blokir/buka blokir), lalu ketik "
"satu IP atau daftar."

#: src/omega_fire/interfaces/cli/help_text.py:467
msgid ""
"Modifie l'état réel du jail immédiatement — l'IP est bloquée/débloquée dès "
"validation, pas seulement enregistrée quelque part."
msgstr ""
"Langsung mengubah status nyata jail — IP diblokir/dibuka begitu dikonfirmasi,"
" tidak sekadar dicatat di suatu tempat."

#: src/omega_fire/interfaces/cli/help_text.py:471
msgid ""
"Une IP déjà bannie ne peut pas être bannie une seconde fois (et inversement "
"pour le débannissement) — l'action échoue proprement dans ce cas plutôt que "
"de prétendre avoir réussi."
msgstr ""
"IP yang sudah diblokir tidak dapat diblokir dua kali (dan sebaliknya untuk "
"buka blokir) — dalam hal ini tindakan gagal dengan jelas alih-alih berpura-"
"pura berhasil."

#: src/omega_fire/interfaces/cli/help_text.py:474
msgid ""
"Vérifie le nom du jail affiché avant de valider : une IP bannie dans le "
"mauvais jail ne protège pas la bonne surface."
msgstr ""
"Periksa nama jail yang ditampilkan sebelum mengonfirmasi: IP yang diblokir di"
" jail yang salah tidak melindungi permukaan yang tepat."

#: src/omega_fire/interfaces/cli/help_text.py:481
msgid ""
"Transfère des IPs entre jails fail2ban, vers/depuis les backends firewall "
"(nftables/iptables), ou depuis/vers des fichiers."
msgstr ""
"Memindahkan IP antar jail fail2ban, ke/dari backend firewall "
"(nftables/iptables), atau dari/ke file."

#: src/omega_fire/interfaces/cli/help_text.py:503
msgid ""
"Assistant de création d'un nouveau jail : mode sur-mesure (tu choisis chaque "
"paramètre) ou mode preset (modèles pré-configurés pour Nginx, Apache, Caddy, "
"SSH...)."
msgstr ""
"Asisten pembuatan jail baru: mode kustom (Anda memilih setiap parameter) atau"
" mode preset (templat siap pakai untuk Nginx, Apache, Caddy, SSH...)."

#: src/omega_fire/interfaces/cli/help_text.py:508
msgid ""
"Mode sur-mesure : nom du jail, chemin de log à surveiller (liste épinglée "
"modifiable directement depuis cet écran), ports concernés, nom du filtre, "
"règles de bannissement (maxretry / findtime / bantime)."
msgstr ""
"Mode kustom: nama jail, jalur log yang dipantau (daftar tersemat dapat "
"disunting langsung dari layar ini), port terkait, nama filter, aturan blokir "
"(maxretry / findtime / bantime)."

#: src/omega_fire/interfaces/cli/help_text.py:512
msgid "Mode preset : choisis directement un modèle déjà réglé."
msgstr "Mode preset: langsung pilih templat yang sudah diatur."

#: src/omega_fire/interfaces/cli/help_text.py:515
msgid ""
"Écrit un fichier de configuration réel et recharge fail2ban — le jail devient"
" actif immédiatement."
msgstr ""
"Menulis file konfigurasi nyata dan memuat ulang fail2ban — jail langsung "
"aktif."

#: src/omega_fire/interfaces/cli/help_text.py:517
msgid ""
"Si le filtre demandé n'existe pas encore, un filtre générique (détection "
"d'erreurs HTTP 400/401/403/404/500) est créé automatiquement."
msgstr ""
"Jika filter yang diminta belum ada, filter generik (deteksi kesalahan HTTP "
"400/401/403/404/500) dibuat otomatis."

#: src/omega_fire/interfaces/cli/help_text.py:522
msgid ""
"Le filtre générique automatique est pensé pour des logs HTTP "
"(Nginx/Apache/Caddy/Lighttpd) — appliqué à un log qui n'a pas ce format (ex: "
"syslog), il ne détectera jamais rien."
msgstr ""
"Filter generik otomatis dirancang untuk log HTTP "
"(Nginx/Apache/Caddy/Lighttpd) — jika diterapkan pada log dengan format lain "
"(mis.: syslog), filter ini tidak akan pernah mendeteksi apa pun."

#: src/omega_fire/interfaces/cli/help_text.py:525
msgid ""
"Pour omega-serv et omega-waf, omega-jail installe en une commande des jails "
"déjà réglés (WAF, Active Defense, scans, force brute) : l'écran le rappelle "
"quand omega-serv est détecté sans omega-jail."
msgstr ""
"Untuk omega-serv dan omega-waf, omega-jail memasang dengan satu perintah jail"
" yang sudah disetel (WAF, Active Defense, pemindaian, brute force): layar "
"mengingatkannya saat omega-serv terdeteksi tanpa omega-jail."

#: src/omega_fire/interfaces/cli/help_text.py:530
msgid ""
"Supprime un jail : arrête son suivi, retire sa configuration et recharge "
"fail2ban."
msgstr ""
"Menghapus jail: menghentikan pemantauannya, menghapus konfigurasinya, dan "
"memuat ulang fail2ban."

#: src/omega_fire/interfaces/cli/help_text.py:532
msgid ""
"Choisis le jail à supprimer et confirme. Chaque jail est listé avec son "
"origine et le fichier qui le définit, retrouvé par le nom de sa section, quel"
" que soit le nom du fichier."
msgstr ""
"Pilih jail yang akan dihapus lalu konfirmasi. Setiap jail ditampilkan dengan "
"asal dan file yang mendefinisikannya, ditemukan dari nama bagiannya, apa pun "
"nama filenya."

#: src/omega_fire/interfaces/cli/help_text.py:535
msgid ""
"Les IPs actuellement bannies dans ce jail sont libérées quand le jail est "
"arrêté — consulte 4.1 avant si tu veux connaître son contenu."
msgstr ""
"IP yang saat ini diblokir di jail ini dibebaskan saat jail dihentikan — lihat"
" 4.1 dulu jika ingin mengetahui isinya."

#: src/omega_fire/interfaces/cli/help_text.py:537
msgid ""
"Son fichier de jail.d est supprimé, ainsi que son filtre s'il lui est propre "
"(créé par Omega-Fire ou par omega-jail) ; un filtre standard de fail2ban "
"(sshd…) n'est jamais supprimé."
msgstr ""
"File jail.d-nya dihapus, beserta filternya jika miliknya sendiri (dibuat oleh"
" Omega-Fire atau omega-jail); filter standar fail2ban (sshd…) tidak pernah "
"dihapus."

#: src/omega_fire/interfaces/cli/help_text.py:540
msgid "Irréversible sans recréer le jail depuis zéro (4.4)."
msgstr "Tidak dapat dibatalkan tanpa membuat ulang jail dari awal (4.4)."

#: src/omega_fire/interfaces/cli/help_text.py:541
msgid ""
"Jail installé par omega-jail : la confirmation le signale ; omega-jail le "
"recréera à sa prochaine installation (« omega-jail --apply »)."
msgstr ""
"Jail yang dipasang oleh omega-jail: konfirmasi menyebutkannya; omega-jail "
"akan membuatnya lagi pada pemasangan berikutnya (\"omega-jail --apply\")."

#: src/omega_fire/interfaces/cli/help_text.py:542
msgid ""
"Jail défini dans jail.local / jail.conf, ou dans un fichier de jail.d qui "
"définit aussi d'autres jails : rien n'est supprimé, le message explique "
"comment le désactiver ou retirer sa section à la main."
msgstr ""
"Jail yang didefinisikan di jail.local / jail.conf, atau di file jail.d yang "
"juga mendefinisikan jail lain: tidak ada yang dihapus, pesan menjelaskan cara"
" menonaktifkannya atau menghapus bagiannya secara manual."

#: src/omega_fire/interfaces/cli/help_text.py:547
msgid ""
"Débannit toutes les IPs d'un seul jail (celui que tu choisis), sans toucher "
"aux autres."
msgstr ""
"Membuka blokir semua IP dari satu jail (yang Anda pilih), tanpa menyentuh "
"yang lain."

#: src/omega_fire/interfaces/cli/help_text.py:548
msgid "Sélectionne le jail à vider et confirme."
msgstr "Pilih jail yang akan dikosongkan lalu konfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:549
msgid ""
"Toutes les IPs actuellement bannies dans ce jail précis sont débannies "
"immédiatement."
msgstr "Semua IP yang saat ini diblokir di jail ini langsung dibuka blokirnya."

#: src/omega_fire/interfaces/cli/help_text.py:551
msgid ""
"Ne touche qu'au jail sélectionné — pour vider tous les jails d'un coup, "
"utilise 4.7, pas cette option répétée plusieurs fois."
msgstr ""
"Hanya menyentuh jail yang dipilih — untuk mengosongkan semua jail sekaligus, "
"gunakan 4.7, jangan mengulang opsi ini berkali-kali."

#: src/omega_fire/interfaces/cli/help_text.py:557
msgid ""
"PURGE GÉNÉRALE : débannit toutes les IPs de tous les jails configurés, en une"
" seule opération."
msgstr ""
"PEMBERSIHAN UMUM: membuka blokir semua IP dari semua jail yang dikonfigurasi,"
" dalam satu operasi."

#: src/omega_fire/interfaces/cli/help_text.py:558
msgid ""
"Une confirmation est demandée avant exécution — lis-la attentivement, "
"l'opération touche l'ensemble des jails."
msgstr ""
"Konfirmasi diminta sebelum eksekusi — baca dengan teliti, operasi ini "
"menyentuh semua jail."

#: src/omega_fire/interfaces/cli/help_text.py:559
msgid ""
"Toutes les IPs actuellement bannies, dans tous les jails, sont débannies "
"immédiatement. Non sélectif."
msgstr ""
"Semua IP yang saat ini diblokir, di semua jail, langsung dibuka blokirnya. "
"Tidak selektif."

#: src/omega_fire/interfaces/cli/help_text.py:560
msgid ""
"Opération large et irréversible — pour ne vider qu'un seul jail, utilise 4.6."
msgstr ""
"Operasi luas dan tidak dapat dibatalkan — untuk mengosongkan hanya satu jail,"
" gunakan 4.6."

#: src/omega_fire/interfaces/cli/help_text.py:565
msgid ""
"Exporte le contenu d'un jail (IPs bannies, configuration) dans un fichier : "
"brut, JSON, TXT (réinjectable), ou HTML (rapport visuel)."
msgstr ""
"Mengekspor isi jail (IP diblokir, konfigurasi) ke file: mentah, JSON, TXT "
"(dapat dimuat ulang), atau HTML (laporan visual)."

#: src/omega_fire/interfaces/cli/help_text.py:568
msgid "Choisis le jail, puis le format de sortie."
msgstr "Pilih jail, lalu format keluaran."

#: src/omega_fire/interfaces/cli/help_text.py:569
msgid "Lecture seule côté fail2ban — l'export ne modifie aucun jail."
msgstr "Hanya baca di sisi fail2ban — ekspor tidak mengubah jail apa pun."

#: src/omega_fire/interfaces/cli/help_text.py:574
msgid ""
"Teste la validité de la configuration fail2ban actuelle (jails, filtres) sans"
" rien modifier ni redémarrer le service."
msgstr ""
"Menguji validitas konfigurasi fail2ban saat ini (jail, filter) tanpa mengubah"
" apa pun atau memulai ulang layanan."

#: src/omega_fire/interfaces/cli/help_text.py:577
msgid "Aucune saisie — lance directement le test."
msgstr "Tidak perlu masukan — pengujian langsung dimulai."

#: src/omega_fire/interfaces/cli/help_text.py:580
msgid ""
"Valide la configuration sur disque sans nécessiter que le démon soit déjà "
"démarré."
msgstr ""
"Memvalidasi konfigurasi di disk tanpa memerlukan daemon sudah berjalan."

#: src/omega_fire/interfaces/cli/help_text.py:587
msgid ""
"Contrôle du service fail2ban lui-même (pas d'un jail précis) : statut, "
"démarrage, arrêt, redémarrage, activation/désactivation au démarrage du "
"système."
msgstr ""
"Kendali layanan fail2ban itu sendiri (bukan jail tertentu): status, mulai, "
"hentikan, mulai ulang, aktifkan/nonaktifkan saat sistem boot."

#: src/omega_fire/interfaces/cli/help_text.py:591
msgid "Choisis l'action à effectuer sur le service."
msgstr "Pilih tindakan yang akan dilakukan pada layanan."

#: src/omega_fire/interfaces/cli/help_text.py:593
msgid ""
"Arrêter le service désactive toute la protection fail2ban le temps qu'il est "
"arrêté, pas seulement un jail."
msgstr ""
"Menghentikan layanan menonaktifkan seluruh perlindungan fail2ban selama "
"layanan berhenti, bukan hanya satu jail."

#: src/omega_fire/interfaces/cli/help_text.py:597
msgid ""
"À utiliser avec précaution sur une machine en production — un arrêt du "
"service, même bref, laisse temporairement passer les tentatives que fail2ban "
"aurait bloquées."
msgstr ""
"Gunakan dengan hati-hati pada mesin produksi — penghentian layanan, walau "
"singkat, untuk sementara meloloskan percobaan yang seharusnya diblokir "
"fail2ban."

#: src/omega_fire/interfaces/cli/help_text.py:610
msgid ""
"Analyse et maintenance des logs : Bibliothèque (import des logs), favoris, "
"lecture avec trois lecteurs, analyse de fréquence par IP, purge ciblée, "
"rotation/backup, restauration, statistiques."
msgstr ""
"Analisis dan pemeliharaan log: Pustaka (impor log), favorit, membaca dengan "
"tiga penampil, analisis frekuensi per IP, pembersihan terarah, "
"rotasi/cadangan, pemulihan, statistik."

#: src/omega_fire/interfaces/cli/help_text.py:615
msgid ""
"Les fichiers épinglés (« Gérer les épingles », avec ses presets) forment une "
"seule liste, partagée par 5.4 à 5.6, 2.2, 2.4, 2.7, 2.8, 4.3 (et 2.10), 4.4 "
"et 6.1. La Bibliothèque 5.1, qui alimente 5.2 et 5.3, est une liste "
"distincte."
msgstr ""
"File yang disematkan (\"Kelola item tersemat\", dengan preset-nya) membentuk "
"satu daftar, dipakai bersama oleh 5.4 sampai 5.6, 2.2, 2.4, 2.7, 2.8, 4.3 "
"(dan 2.10), 4.4, dan 6.1. Pustaka 5.1, yang memasok 5.2 dan 5.3, adalah "
"daftar terpisah."

#: src/omega_fire/interfaces/cli/help_text.py:623
msgid ""
"Bibliothèque de logs : l'import des logs qui alimentent 5.2 Favoris et 5.3 "
"Voir les logs. Rien ne se lance d'ici."
msgstr ""
"Pustaka log: impor log yang memasok 5.2 Favorit dan 5.3 Lihat log. Tidak ada "
"yang dijalankan dari sini."

#: src/omega_fire/interfaces/cli/help_text.py:625
msgid ""
"Mode automatique : à chaque ouverture, les journaux des instances omega-serv "
"détectées sur la machine (access.log, error.log, waf-alerts.log du WAF natif,"
" active-defense…) sont ajoutés, ainsi que ceux d'omega-waf aux chemins de "
"l'extra magnet, même hors de var/log/. Un journal retiré à la main n'est plus"
" réimporté automatiquement ; « Importer omega-serv » les réimporte tous."
msgstr ""
"Mode otomatis: setiap kali dibuka, log dari instans omega-serv yang "
"terdeteksi di mesin (access.log, error.log, waf-alerts.log dari WAF bawaan, "
"active-defense…) ditambahkan, beserta log omega-waf di path ekstra magnet, "
"bahkan di luar var/log/. Log yang dihapus manual tidak lagi diimpor ulang "
"otomatis; \"Impor omega-serv\" mengimpor ulang semuanya."

#: src/omega_fire/interfaces/cli/help_text.py:626
msgid ""
"Épingler un chemin : saisis le chemin absolu d'un log (ex. "
"/var/log/nginx/access.log)."
msgstr ""
"Sematkan path: masukkan path absolut sebuah log (mis. "
"/var/log/nginx/access.log)."

#: src/omega_fire/interfaces/cli/help_text.py:627
msgid ""
"Sources distantes (SSH) : enregistre une machine du réseau (hôte, chemin "
"distant, utilisateur, port, clé), puis « Récupérer maintenant » copie le log "
"par scp dans var/log/remote/ et l'ajoute à la Bibliothèque."
msgstr ""
"Sumber jarak jauh (SSH): daftarkan mesin di jaringan (host, path jarak jauh, "
"pengguna, port, kunci), lalu \"Ambil sekarang\" menyalin log lewat scp ke "
"var/log/remote/ dan menambahkannya ke Pustaka."

#: src/omega_fire/interfaces/cli/help_text.py:630
msgid ""
"La Bibliothèque ne contient que des références : retirer un log ne supprime "
"pas le fichier. L'état (taille, absent, vide) est relu à chaque affichage."
msgstr ""
"Pustaka hanya berisi referensi: menghapus log tidak menghapus file. Status "
"(ukuran, tidak ada, kosong) dibaca ulang setiap kali ditampilkan."

#: src/omega_fire/interfaces/cli/help_text.py:631
msgid ""
"Une copie distante n'est pas suivie en direct : relance « Récupérer "
"maintenant » pour la mettre à jour."
msgstr ""
"Salinan jarak jauh tidak dipantau langsung: jalankan lagi \"Ambil sekarang\" "
"untuk memperbaruinya."

#: src/omega_fire/interfaces/cli/help_text.py:634
msgid ""
"SSH : aucune invite de mot de passe n'est possible depuis l'interface. Il "
"faut une clé ou un agent SSH déjà configurés pour l'utilisateur qui lance "
"omega-fire (root avec sudo)."
msgstr ""
"SSH: antarmuka tidak bisa meminta kata sandi. Diperlukan kunci atau agen SSH "
"yang sudah disiapkan untuk pengguna yang menjalankan omega-fire (root lewat "
"sudo)."

#: src/omega_fire/interfaces/cli/help_text.py:635
msgid ""
"Les instances omega-serv sont détectées par leur service systemd (omega-"
"serv*.service) et par leur registre d'instances ; une instance lancée à la "
"main n'est pas vue : épingle ses journaux."
msgstr ""
"Instans omega-serv dideteksi melalui layanan systemd-nya (omega-"
"serv*.service) dan registri instansnya; instans yang dijalankan manual tidak "
"terlihat: sematkan log-nya."

#: src/omega_fire/interfaces/cli/help_text.py:640
msgid ""
"Favoris : combiner des logs de la Bibliothèque, les enregistrer sous un nom "
"avec un lecteur, et les lancer directement."
msgstr ""
"Favorit: menggabungkan log dari Pustaka, menyimpannya dengan nama dan "
"penampil, lalu menjalankannya langsung."

#: src/omega_fire/interfaces/cli/help_text.py:642
msgid ""
"Choisis les numéros des logs (ex. 1,3), un nom et un lecteur, puis « "
"Enregistrer ». « Lancer » ouvre le favori en surbrillance."
msgstr ""
"Pilih nomor log (mis. 1,3), nama, dan penampil, lalu \"Simpan\". \"Jalankan\""
" membuka favorit yang disorot."

#: src/omega_fire/interfaces/cli/help_text.py:644
msgid "Lecture seule sur les logs ouverts."
msgstr "Hanya baca pada log yang dibuka."

#: src/omega_fire/interfaces/cli/help_text.py:646
msgid ""
"Plusieurs logs combinés : lnav seul, le seul lecteur qui sait les fusionner "
"en une vue chronologique ; un autre lecteur est refusé à l'enregistrement."
msgstr ""
"Beberapa log digabung: hanya lnav, satu-satunya penampil yang bisa "
"menyatukannya dalam satu tampilan kronologis; penampil lain ditolak saat "
"menyimpan."

#: src/omega_fire/interfaces/cli/help_text.py:647
msgid ""
"Un log retiré de la Bibliothèque reste dans le favori, mais ne s'ouvre plus "
"s'il n'existe plus."
msgstr ""
"Log yang dihapus dari Pustaka tetap ada di favorit, tetapi tidak lagi terbuka"
" jika sudah tidak ada."

#: src/omega_fire/interfaces/cli/help_text.py:652
msgid ""
"Voir un log de la Bibliothèque sans configuration, avec le lecteur de ton "
"choix."
msgstr ""
"Melihat log dari Pustaka tanpa konfigurasi, dengan penampil pilihan Anda."

#: src/omega_fire/interfaces/cli/help_text.py:654
msgid ""
"Choisis la ligne, puis le lecteur : Simple (tableau de bord temps réel : "
"trafic, statistiques, dernières requêtes), Classique (dernières lignes puis "
"suivi en direct à la demande), ou lnav (navigation, recherche, filtres)."
msgstr ""
"Pilih baris, lalu penampil: Sederhana (dasbor waktu nyata: lalu lintas, "
"statistik, permintaan terbaru), Klasik (baris terakhir, lalu pemantauan "
"langsung bila diminta), atau lnav (navigasi, pencarian, filter)."

#: src/omega_fire/interfaces/cli/help_text.py:657
msgid ""
"lnav sur un gros fichier peut afficher un écran noir quelques secondes, le "
"temps de l'indexation : ce n'est pas un blocage."
msgstr ""
"lnav pada file besar bisa menampilkan layar hitam beberapa detik selama "
"pengindeksan: ini bukan macet."

#: src/omega_fire/interfaces/cli/help_text.py:661
msgid ""
"Analyse un fichier log ou une blocklist pour en extraire le classement des "
"IPs les plus actives (Top N), sur une période choisie."
msgstr ""
"Menganalisis file log atau blocklist untuk mendapatkan peringkat IP paling "
"aktif (Top N), pada periode yang dipilih."

#: src/omega_fire/interfaces/cli/help_text.py:663
msgid ""
"Choisis la source (épinglée, manuelle, ou ajout/retrait d'épingle), la "
"période d'analyse (1h/1j/7j/personnalisée), puis le nombre N d'IPs à "
"afficher."
msgstr ""
"Pilih sumber (tersemat, manual, atau tambah/hapus item tersemat), periode "
"analisis (1j/1h/7h/kustom), lalu jumlah N IP yang ditampilkan."

#: src/omega_fire/interfaces/cli/help_text.py:664
msgid ""
"Après l'analyse, « Exporter » enregistre le classement (JSON, TXT ou HTML) "
"dans le dossier d'exports : 5.5 peut ensuite recharger ces IPs pour les "
"retirer des logs, sans les recopier à la main, et 6.5 les affiche."
msgstr ""
"Setelah analisis, \"Ekspor\" menyimpan peringkat (JSON, TXT, atau HTML) di "
"folder ekspor: lalu 5.5 bisa memuat ulang IP ini untuk menghapusnya dari log "
"tanpa menyalin manual, dan 6.5 menampilkannya."

#: src/omega_fire/interfaces/cli/help_text.py:665
msgid ""
"« Gérer les épingles » → « Presets » propose les chemins usuels (logs "
"système, serveurs web, blocklists d'omega-fire, logs de la Bibliothèque 5.1) "
"présents sur cette machine : coche ceux à épingler."
msgstr ""
"\"Kelola item tersemat\" → \"Preset\" menawarkan path umum (log sistem, "
"server web, blocklist omega-fire, log Pustaka 5.1) yang ada di mesin ini: "
"centang yang ingin disematkan."

#: src/omega_fire/interfaces/cli/help_text.py:667
msgid ""
"Lecture seule. « Exporter » écrit un fichier top-ips_<date> dans le dossier "
"d'exports."
msgstr "Hanya baca. \"Ekspor\" menulis file top-ips_<date> di folder ekspor."

#: src/omega_fire/interfaces/cli/help_text.py:669
msgid ""
"Les fichiers proposés ici viennent de la liste « fichiers de travail » "
"partagée avec 5.5, 5.6 et les écrans de blocklists (épingles persistées), "
"distincte de la Bibliothèque 5.1."
msgstr ""
"File yang ditawarkan di sini berasal dari daftar \"file kerja\" yang dipakai "
"bersama dengan 5.5, 5.6, dan layar blocklist (item tersemat yang disimpan), "
"terpisah dari Pustaka 5.1."

#: src/omega_fire/interfaces/cli/help_text.py:676
msgid ""
"Retire toutes les lignes contenant une IP précise dans un fichier source (log"
" ou blocklist) — édition directe du fichier, pas un débannissement."
msgstr ""
"Menghapus semua baris yang berisi IP tertentu di file sumber (log atau "
"blocklist) — penyuntingan langsung file, bukan pembukaan blokir."

#: src/omega_fire/interfaces/cli/help_text.py:678
msgid ""
"Choisis le fichier source, saisis une ou plusieurs IPs (séparées par des "
"virgules), vérifie le récapitulatif (lignes trouvées par IP) avant de "
"confirmer."
msgstr ""
"Pilih file sumber, masukkan satu atau beberapa IP (dipisahkan koma), periksa "
"ringkasan (baris yang ditemukan per IP) sebelum mengonfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:679
msgid ""
"« Charger depuis un export » liste les exports contenant des IPs (Top N de "
"5.4 en premier, puis blacklist 6.1 et jails 4.8) : choisis le fichier, coche "
"les IPs à retirer."
msgstr ""
"\"Muat dari ekspor\" menampilkan ekspor yang berisi IP (Top N dari 5.4 lebih "
"dulu, lalu daftar hitam 6.1 dan jail 4.8): pilih file, centang IP yang akan "
"dihapus."

#: src/omega_fire/interfaces/cli/help_text.py:681
msgid ""
"Modifie réellement le fichier — les lignes contenant l'une des IPs sont "
"supprimées, les autres conservées."
msgstr ""
"Benar-benar mengubah file — baris yang berisi salah satu IP dihapus, sisanya "
"dipertahankan."

#: src/omega_fire/interfaces/cli/help_text.py:682
msgid ""
"N'agit que sur le fichier choisi, pas sur l'état réel du firewall/fail2ban — "
"pour débannir une IP, utilise 2.3 ou 4.2."
msgstr ""
"Hanya bekerja pada file yang dipilih, bukan pada status nyata "
"firewall/fail2ban — untuk membuka blokir IP, gunakan 2.3 atau 4.2."

#: src/omega_fire/interfaces/cli/help_text.py:686
msgid ""
"Sauvegarde (backup) manuelle ou automatisée de fichiers logs/blocklists dans "
"une archive."
msgstr "Pencadangan manual atau otomatis file log/blocklist ke dalam arsip."

#: src/omega_fire/interfaces/cli/help_text.py:687
msgid ""
"Choisis la source à sauvegarder, puis le mode : sauvegarde immédiate, "
"planification d'une automatisation récurrente, ou gestion des automatisations"
" existantes."
msgstr ""
"Pilih sumber yang akan dicadangkan, lalu mode: cadangkan sekarang, jadwalkan "
"otomatisasi berulang, atau kelola otomatisasi yang ada."

#: src/omega_fire/interfaces/cli/help_text.py:689
msgid ""
"Crée une archive réelle dans var/backups/. Une automatisation configurée "
"continue de s'exécuter aux intervalles définis tant qu'elle n'est pas "
"supprimée via [3]."
msgstr ""
"Membuat arsip nyata di var/backups/. Otomatisasi yang dikonfigurasi terus "
"berjalan pada interval yang ditentukan sampai dihapus melalui [3]."

#: src/omega_fire/interfaces/cli/help_text.py:696
msgid ""
"Restaure une archive de logs précédemment sauvegardée (menu 5.6), "
"immédiatement ou selon une automatisation planifiée."
msgstr ""
"Memulihkan arsip log yang dicadangkan sebelumnya (menu 5.6), segera atau "
"sesuai otomatisasi terjadwal."

#: src/omega_fire/interfaces/cli/help_text.py:697
msgid ""
"Choisis le mode (restauration immédiate, planification, gestion des "
"automatisations existantes), puis l'archive et la stratégie de restauration."
msgstr ""
"Pilih mode (pulihkan segera, jadwalkan, kelola otomatisasi yang ada), lalu "
"arsip dan strategi pemulihan."

#: src/omega_fire/interfaces/cli/help_text.py:698
msgid ""
"Écrit réellement les fichiers restaurés — une restauration peut écraser des "
"fichiers actuels selon le mode choisi."
msgstr ""
"Benar-benar menulis file yang dipulihkan — tergantung mode yang dipilih, "
"pemulihan dapat menimpa file saat ini."

#: src/omega_fire/interfaces/cli/help_text.py:699
msgid "Vérifie la stratégie/mode proposés avant de confirmer."
msgstr "Periksa strategi/mode yang diusulkan sebelum mengonfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:703
msgid ""
"Purge et nettoie les archives de backup (var/backups/) selon différents "
"critères : ancienneté, quota, type (sauvegardes automatiques de sécurité), ou"
" sélection manuelle."
msgstr ""
"Membersihkan arsip cadangan (var/backups/) menurut berbagai kriteria: usia, "
"kuota, jenis (cadangan keamanan otomatis), atau pilihan manual."

#: src/omega_fire/interfaces/cli/help_text.py:704
msgid ""
"Consulte d'abord les statistiques de stockage affichées (nombre d'archives, "
"volume, espace disque libre), puis choisis le critère de purge."
msgstr ""
"Lihat dulu statistik penyimpanan yang ditampilkan (jumlah arsip, volume, "
"ruang disk kosong), lalu pilih kriteria pembersihan."

#: src/omega_fire/interfaces/cli/help_text.py:705
msgid ""
"Suppression réelle et irréversible des archives ciblées — une confirmation "
"avec aperçu des fichiers concernés est demandée avant exécution."
msgstr ""
"Penghapusan nyata dan permanen arsip yang ditargetkan — konfirmasi dengan "
"pratinjau file terkait diminta sebelum eksekusi."

#: src/omega_fire/interfaces/cli/help_text.py:709
msgid ""
"Nettoyage avancé de l'espace de stockage interne d'Omega-Fire (logs, cache, "
"exports, backups, ou tout var/), filtré par âge ou taille."
msgstr ""
"Pembersihan lanjutan ruang penyimpanan internal Omega-Fire (log, cache, "
"ekspor, cadangan, atau seluruh var/), difilter menurut usia atau ukuran."

#: src/omega_fire/interfaces/cli/help_text.py:710
msgid ""
"Choisis le(s) dossier(s) cible(s), puis les critères de filtrage, et vérifie "
"l'aperçu des fichiers concernés avant de confirmer."
msgstr ""
"Pilih folder target, lalu kriteria penyaringan, dan periksa pratinjau file "
"terkait sebelum mengonfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:711
msgid "Suppression réelle et irréversible des fichiers correspondants."
msgstr "Penghapusan nyata dan permanen file yang sesuai."

#: src/omega_fire/interfaces/cli/help_text.py:713
msgid ""
"app.log et audit.log sont toujours exclus de ce nettoyage, même si le dossier"
" logs/ est ciblé — ce sont des fichiers actifs en écriture continue ; utilise"
" 1.5 ou 7.3 pour les gérer spécifiquement."
msgstr ""
"app.log dan audit.log selalu dikecualikan dari pembersihan ini, meskipun "
"folder logs/ ditargetkan — keduanya file aktif yang terus ditulisi; gunakan "
"1.5 atau 7.3 untuk mengelolanya secara khusus."

#: src/omega_fire/interfaces/cli/help_text.py:721
msgid ""
"Affiche un tableau de bord de statistiques sur les logs (volumes, tendances)."
msgstr "Menampilkan dasbor statistik log (volume, tren)."

#: src/omega_fire/interfaces/cli/help_text.py:732
msgid ""
"Centralise les exports et rapports : blacklist complète, règles de pare-feu, "
"audit système complet, statistiques fail2ban — et 6.5 pour les retrouver et "
"les ouvrir."
msgstr ""
"Memusatkan ekspor dan laporan: daftar hitam lengkap, aturan firewall, audit "
"sistem lengkap, statistik fail2ban — dan 6.5 untuk menemukan dan membukanya."

#: src/omega_fire/interfaces/cli/help_text.py:733
msgid ""
"Chaque export propose un format (JSON/TXT/HTML selon le rapport) et un chemin"
" de destination modifiable."
msgstr ""
"Setiap ekspor menawarkan format (JSON/TXT/HTML tergantung laporan) dan jalur "
"tujuan yang dapat diubah."

#: src/omega_fire/interfaces/cli/help_text.py:737
msgid ""
"Exporte la blacklist complète (IPs bannies) depuis un fichier source choisi, "
"au format JSON, TXT ou HTML."
msgstr ""
"Mengekspor blacklist lengkap (IP diblokir) dari file sumber yang dipilih, "
"dalam format JSON, TXT, atau HTML."

#: src/omega_fire/interfaces/cli/help_text.py:738
msgid ""
"Choisis la source (épinglée, manuelle, ou gestion des épingles), puis le "
"format de sortie."
msgstr ""
"Pilih sumber (tersemat, manual, atau kelola item tersemat), lalu format "
"keluaran."

#: src/omega_fire/interfaces/cli/help_text.py:739
msgid "Écrit un fichier réel — lecture seule côté bannissement."
msgstr "Menulis file nyata — hanya baca di sisi blokir."

#: src/omega_fire/interfaces/cli/help_text.py:743
msgid ""
"Exporte les règles de pare-feu nftables/iptables (fail2ban a son propre "
"export, voir 4.8) — toutes, actives seulement, Omega-Fire uniquement, ou "
"système importées uniquement."
msgstr ""
"Mengekspor aturan firewall nftables/iptables (fail2ban punya ekspor sendiri, "
"lihat 4.8) — semua, hanya yang aktif, hanya Omega-Fire, atau hanya aturan "
"sistem yang diimpor."

#: src/omega_fire/interfaces/cli/help_text.py:744
msgid "Choisis le contenu à exporter, puis le format (JSON/HTML/TXT)."
msgstr "Pilih isi yang akan diekspor, lalu format (JSON/HTML/TXT)."

#: src/omega_fire/interfaces/cli/help_text.py:745
msgid "Écrit un fichier réel — lecture seule côté règles."
msgstr "Menulis file nyata — hanya baca di sisi aturan."

#: src/omega_fire/interfaces/cli/help_text.py:749
msgid ""
"Génère un rapport d'audit complet : état système, historique, top IPs, en un "
"seul document."
msgstr ""
"Membuat laporan audit lengkap: status sistem, riwayat, top IP, dalam satu "
"dokumen."

#: src/omega_fire/interfaces/cli/help_text.py:750
msgid ""
"Choisis le format (TXT ou HTML), valide le chemin de destination proposé ou "
"saisis-en un autre."
msgstr ""
"Pilih format (TXT atau HTML), konfirmasi jalur tujuan yang diusulkan atau "
"ketik jalur lain."

#: src/omega_fire/interfaces/cli/help_text.py:751
msgid "Écrit un fichier réel — lecture seule côté système."
msgstr "Menulis file nyata — hanya baca di sisi sistem."

#: src/omega_fire/interfaces/cli/help_text.py:755
msgid ""
"Exporte un rapport détaillé sur fail2ban (jails et bans), au format TXT ou "
"HTML."
msgstr ""
"Mengekspor laporan rinci fail2ban (jail dan blokir), dalam format TXT atau "
"HTML."

#: src/omega_fire/interfaces/cli/help_text.py:756
msgid "Choisis le format, valide ou modifie le chemin de destination proposé."
msgstr "Pilih format, konfirmasi atau ubah jalur tujuan yang diusulkan."

#: src/omega_fire/interfaces/cli/help_text.py:757
msgid "Écrit un fichier réel — lecture seule côté fail2ban."
msgstr "Menulis file nyata — hanya baca di sisi fail2ban."

#: src/omega_fire/interfaces/cli/help_text.py:761
msgid ""
"Liste tous les fichiers exportés (dossier d'exports, et exports de blacklist "
"de 6.1) : type, date, taille — sans ouvrir de terminal ni de gestionnaire de "
"fichiers."
msgstr ""
"Menampilkan semua file yang diekspor (folder ekspor, dan ekspor daftar hitam "
"dari 6.1): jenis, tanggal, ukuran — tanpa membuka terminal atau pengelola "
"file."

#: src/omega_fire/interfaces/cli/help_text.py:763
msgid ""
"« Ouvrir » : un rapport HTML s'ouvre dans votre navigateur ; un JSON ou TXT "
"se lit dans omega-fire (lecteur Classique)."
msgstr ""
"\"Buka\": laporan HTML terbuka di peramban Anda; JSON atau TXT dibaca di "
"omega-fire (penampil Klasik)."

#: src/omega_fire/interfaces/cli/help_text.py:764
msgid ""
"« Copier le chemin » copie le chemin complet du fichier ; « Supprimer » "
"l'efface après confirmation."
msgstr ""
"\"Salin path\" menyalin path lengkap file; \"Hapus\" menghapusnya setelah "
"konfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:766
msgid ""
"Ouvrir et copier sont en lecture seule. Supprimer efface réellement le "
"fichier."
msgstr "Buka dan salin bersifat hanya baca. Hapus benar-benar menghapus file."

#: src/omega_fire/interfaces/cli/help_text.py:768
msgid ""
"omega-fire tourne en root : le navigateur est lancé au nom de l'utilisateur "
"qui a fait sudo, dans sa session graphique. Si le fichier ne lui est pas "
"lisible, une copie lui appartenant est ouverte depuis un dossier temporaire."
msgstr ""
"omega-fire berjalan sebagai root: peramban dijalankan atas nama pengguna yang"
" menjalankan sudo, di sesi grafisnya. Jika file tidak bisa dibaca olehnya, "
"salinan miliknya dibuka dari folder sementara."

#: src/omega_fire/interfaces/cli/help_text.py:769
msgid ""
"Sans session graphique (connexion SSH, serveur sans bureau), aucun navigateur"
" ne peut s'ouvrir : le chemin du fichier est affiché pour l'ouvrir depuis un "
"autre poste."
msgstr ""
"Tanpa sesi grafis (koneksi SSH, server tanpa desktop), tidak ada peramban "
"yang bisa terbuka: path file ditampilkan agar bisa dibuka dari komputer lain."

#: src/omega_fire/interfaces/cli/help_text.py:780
msgid ""
"Gestion de l'état interne d'Omega-Fire : sauvegarde/restauration complète "
"(règles + IPs bannies), historique d'audit, rechargement de la configuration."
msgstr ""
"Pengelolaan status internal Omega-Fire: pencadangan/pemulihan lengkap (aturan"
" + IP diblokir), riwayat audit, muat ulang konfigurasi."

#: src/omega_fire/interfaces/cli/help_text.py:784
msgid ""
"Distinct du menu 5 (qui gère les fichiers de logs) — ici, c'est l'état du "
"firewall/fail2ban lui-même qui est sauvegardé/restauré."
msgstr ""
"Berbeda dari menu 5 (yang mengelola file log) — di sini status "
"firewall/fail2ban itu sendiri yang dicadangkan/dipulihkan."

#: src/omega_fire/interfaces/cli/help_text.py:788
msgid ""
"Capture un instantané (snapshot) complet de l'état actuel : règles firewall "
"et IPs bannies (nftables/iptables/fail2ban)."
msgstr ""
"Mengambil snapshot lengkap status saat ini: aturan firewall dan IP diblokir "
"(nftables/iptables/fail2ban)."

#: src/omega_fire/interfaces/cli/help_text.py:789
msgid ""
"Une description optionnelle peut être ajoutée pour identifier facilement le "
"snapshot plus tard."
msgstr ""
"Deskripsi opsional dapat ditambahkan agar snapshot mudah dikenali nanti."

#: src/omega_fire/interfaces/cli/help_text.py:790
msgid ""
"Crée une archive réelle — n'affecte aucun état actuel, uniquement une "
"sauvegarde."
msgstr ""
"Membuat arsip nyata — tidak memengaruhi status saat ini, hanya cadangan."

#: src/omega_fire/interfaces/cli/help_text.py:794
msgid "Restaure un snapshot précédemment sauvegardé (menu 7.1)."
msgstr "Memulihkan snapshot yang sebelumnya disimpan (menu 7.1)."

#: src/omega_fire/interfaces/cli/help_text.py:795
msgid ""
"Sélectionne le snapshot à restaurer dans la liste paginée, puis confirme."
msgstr ""
"Pilih snapshot yang akan dipulihkan dari daftar berhalaman, lalu konfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:797
msgid ""
"Les règles firewall actuellement gérées par Omega-Fire sont RETIRÉES puis "
"REMPLACÉES par celles du snapshot."
msgstr ""
"Aturan firewall yang saat ini dikelola Omega-Fire DIHAPUS lalu DIGANTI dengan"
" aturan dari snapshot."

#: src/omega_fire/interfaces/cli/help_text.py:799
msgid ""
"Seules les règles que le snapshot peut recréer à l'identique sont "
"réappliquées (chaîne de base, avec seulement protocole, port, adresses, "
"commentaire et verdict). Les autres — règles d'autres outils ou avec des "
"critères qu'Omega-Fire ne sait pas reproduire (état de connexion, interface, "
"type ICMP, limite de débit) — restent telles quelles dans le pare-feu."
msgstr ""
"Hanya aturan yang bisa dibuat ulang persis sama oleh snapshot yang diterapkan"
" kembali (rantai dasar, hanya dengan protokol, port, alamat, komentar, dan "
"putusan). Yang lain — aturan alat lain atau dengan kriteria yang tidak bisa "
"direproduksi Omega-Fire (status koneksi, antarmuka, jenis ICMP, batas laju) —"
" tetap seperti apa adanya di firewall."

#: src/omega_fire/interfaces/cli/help_text.py:800
msgid ""
"Un snapshot créé avant la version 3.5 ne porte pas cette information : sa "
"restauration ne touche à aucune règle, seules les IPs bannies sont ajoutées."
msgstr ""
"Snapshot yang dibuat sebelum versi 3.5 tidak memuat informasi ini: "
"pemulihannya tidak menyentuh aturan apa pun, hanya IP yang diblokir yang "
"ditambahkan."

#: src/omega_fire/interfaces/cli/help_text.py:801
msgid ""
"La politique par défaut des chaînes n'est remise à ACCEPT que sur un backend "
"où un profil (3.4) était actif."
msgstr ""
"Kebijakan bawaan rantai hanya diatur ulang ke ACCEPT pada backend yang "
"memiliki profil (3.4) aktif."

#: src/omega_fire/interfaces/cli/help_text.py:802
msgid ""
"Les IPs bannies du snapshot sont AJOUTÉES — rien n'est retiré des "
"bannissements actuels."
msgstr ""
"IP yang diblokir dalam snapshot DITAMBAHKAN — tidak ada yang dihapus dari "
"blokir saat ini."

#: src/omega_fire/interfaces/cli/help_text.py:804
msgid ""
"Les jails fail2ban ne sont PAS restaurées automatiquement (information "
"seulement)."
msgstr "Jail fail2ban TIDAK dipulihkan otomatis (hanya informasi)."

#: src/omega_fire/interfaces/cli/help_text.py:806
msgid ""
"Les règles/IPs gérées par d'autres outils (UFW, etc.) ne sont jamais "
"touchées."
msgstr "Aturan/IP yang dikelola alat lain (UFW, dll.) tidak pernah disentuh."

#: src/omega_fire/interfaces/cli/help_text.py:809
msgid ""
"Opération significative sur les règles firewall — vérifie bien le snapshot "
"choisi avant de confirmer."
msgstr ""
"Operasi penting pada aturan firewall — periksa baik-baik snapshot yang "
"dipilih sebelum mengonfirmasi."

#: src/omega_fire/interfaces/cli/help_text.py:813
msgid ""
"Consulte ou purge l'historique d'audit (le journal des actions effectuées par"
" Omega-Fire, avec succès/échec) — distinct du journal applicatif technique "
"(1.5)."
msgstr ""
"Melihat atau membersihkan riwayat audit (log tindakan yang dilakukan Omega-"
"Fire, dengan berhasil/gagal) — berbeda dari log aplikasi teknis (1.5)."

#: src/omega_fire/interfaces/cli/help_text.py:814
msgid ""
"Recherche par mot-clé possible. Le sous-menu de gestion permet de purger les "
"entrées anciennes."
msgstr ""
"Pencarian dengan kata kunci tersedia. Submenu pengelolaan memungkinkan "
"membersihkan entri lama."

#: src/omega_fire/interfaces/cli/help_text.py:815
msgid ""
"La consultation est en lecture seule. La purge supprime réellement des "
"entrées, irréversible."
msgstr ""
"Mode lihat hanya baca. Pembersihan benar-benar menghapus entri, secara "
"permanen."

#: src/omega_fire/interfaces/cli/help_text.py:819
msgid "Recharge la configuration système sans redémarrer l'application."
msgstr "Memuat ulang konfigurasi sistem tanpa memulai ulang aplikasi."

#: src/omega_fire/interfaces/cli/help_text.py:820
msgid "Aucune saisie — lance directement le rechargement."
msgstr "Tidak perlu masukan — pemuatan ulang langsung dimulai."

#: src/omega_fire/interfaces/cli/help_text.py:822
msgid ""
"Même mécanisme que 1.3 (re-scan complet des sondes système et de la "
"configuration), avec un affichage minimal plutôt que le détail diagnostic "
"complet."
msgstr ""
"Mekanisme yang sama dengan 1.3 (pemindaian ulang lengkap probe sistem dan "
"konfigurasi), dengan tampilan minimal alih-alih detail diagnostik lengkap."

#: src/omega_fire/interfaces/cli/help_text.py:834
msgid ""
"Vue d'ensemble de l'activité réseau en temps réel et sur la durée : tableau "
"de bord live, connexions actives, tendances 7/30 jours."
msgstr ""
"Gambaran aktivitas jaringan secara waktu nyata dan dari waktu ke waktu: "
"dasbor langsung, koneksi aktif, tren 7/30 hari."

#: src/omega_fire/interfaces/cli/help_text.py:838
msgid ""
"Tableau de bord en temps réel combinant statistiques firewall, monitoring, "
"audit et logs — rafraîchi automatiquement."
msgstr ""
"Dasbor waktu nyata yang menggabungkan statistik firewall, pemantauan, audit, "
"dan log — disegarkan otomatis."

#: src/omega_fire/interfaces/cli/help_text.py:839
msgid ""
"Aucune saisie au lancement — consulte l'écran, quitte avec la touche indiquée"
" à l'écran."
msgstr ""
"Tidak perlu masukan saat mulai — lihat layar, keluar dengan tombol yang "
"ditunjukkan di layar."

#: src/omega_fire/interfaces/cli/help_text.py:844
msgid ""
"Affiche les connexions réseau actives (conntrack) : protocole, état, "
"adresses, ports."
msgstr ""
"Menampilkan koneksi jaringan yang aktif (conntrack): protokol, status, "
"alamat, port."

#: src/omega_fire/interfaces/cli/help_text.py:845
msgid ""
"Filtre par protocole et/ou état une fois la liste initiale affichée, limite "
"le nombre d'entrées affichées."
msgstr ""
"Filter berdasarkan protokol dan/atau status setelah daftar awal tampil, "
"batasi jumlah entri yang ditampilkan."

#: src/omega_fire/interfaces/cli/help_text.py:850
msgid "Rapport statistique sur les 7 derniers jours (tendances, graphiques)."
msgstr "Laporan statistik 7 hari terakhir (tren, grafik)."

#: src/omega_fire/interfaces/cli/help_text.py:856
msgid ""
"Rapport statistique sur les 30 derniers jours — vue macro, même mécanisme que"
" 8.3 avec une fenêtre plus large."
msgstr ""
"Laporan statistik 30 hari terakhir — gambaran makro, mekanisme yang sama "
"dengan 8.3 dengan jendela lebih lebar."

#: src/omega_fire/interfaces/cli/help_text.py:863
msgid ""
"Visualise en direct les logs serveur (Nginx, Apache, Caddy, Lighttpd) ou le "
"journal applicatif, avec analyse des requêtes HTTP en temps réel. C'est aussi"
" le lecteur « Simple » de 5.2 Favoris et 5.3 Voir les logs."
msgstr ""
"Menampilkan langsung log server (Nginx, Apache, Caddy, Lighttpd) atau log "
"aplikasi, dengan analisis permintaan HTTP waktu nyata. Ini juga penampil "
"\"Sederhana\" dari 5.2 Favorit dan 5.3 Lihat log."

#: src/omega_fire/interfaces/cli/help_text.py:869
msgid ""
"Choisis une source épinglée, l'historique récent, ou saisis un chemin/URL "
"manuellement."
msgstr ""
"Pilih sumber tersemat, riwayat terbaru, atau ketik jalur/URL secara manual."

#: src/omega_fire/interfaces/cli/help_text.py:871
msgid ""
"Utilise [G] pour gérer les épingles (ajouter/retirer) et l'historique — un "
"[0] Annuler est disponible à chaque étape."
msgstr ""
"Gunakan [G] untuk mengelola item tersemat (tambah/hapus) dan riwayat — [0] "
"Batal tersedia di setiap langkah."

#: src/omega_fire/interfaces/cli/help_text.py:874
msgid ""
"Lecture seule sur la source suivie — aucune modification du fichier ou du "
"serveur observé."
msgstr ""
"Hanya baca pada sumber yang dipantau — file atau server yang diamati tidak "
"diubah."

#: src/omega_fire/interfaces/cli/help_text.py:876
msgid ""
"Les épingles et l'historique sont persistés (survivent à un redémarrage). "
"Ouvert depuis 5.2 ou 5.3, il démarre directement sur le log choisi, sans "
"toucher à cet historique."
msgstr ""
"Item tersemat dan riwayat disimpan (tetap ada setelah mulai ulang). Saat "
"dibuka dari 5.2 atau 5.3, langsung dimulai pada log yang dipilih tanpa "
"menyentuh riwayat ini."

#: src/omega_fire/interfaces/cli/help_text.py:884
msgid ""
"Sélectionne un ou plusieurs fichiers de logs serveur (Nginx, Apache, "
"Lighttpd, Caddy) pour analyse via lnav — contrairement à 8.5, plusieurs "
"fichiers peuvent être choisis à la fois : lnav les fusionne automatiquement "
"en une seule vue chronologique."
msgstr ""
"Pilih satu atau beberapa file log server (Nginx, Apache, Lighttpd, Caddy) "
"untuk dianalisis dengan lnav — berbeda dengan 8.5, beberapa file bisa dipilih"
" sekaligus: lnav otomatis menyatukannya dalam satu tampilan kronologis."

#: src/omega_fire/interfaces/cli/help_text.py:890
msgid ""
"Numéros séparés par des virgules pour choisir plusieurs sources "
"épinglées/historique à la fois (ex: 1,3)."
msgstr ""
"Nomor dipisahkan koma untuk memilih beberapa sumber tersemat/riwayat "
"sekaligus (mis.: 1,3)."

#: src/omega_fire/interfaces/cli/help_text.py:892
msgid ""
"[M] pour un ou plusieurs chemins saisis à la main (mêmes virgules), [G] pour "
"gérer les épingles — un [0]/Entrée annule à chaque étape."
msgstr ""
"[M] untuk satu atau beberapa jalur yang diketik manual (koma yang sama), [G] "
"untuk mengelola item tersemat — [0]/Enter membatalkan di setiap langkah."

#: src/omega_fire/interfaces/cli/help_text.py:896
msgid "Lecture seule sur les fichiers sélectionnés — aucune modification."
msgstr "Hanya baca pada file yang dipilih — tanpa perubahan."

#: src/omega_fire/interfaces/cli/help_text.py:898
msgid ""
"Épingles et historique propres à 8.6 (séparés de ceux de 8.5, mêmes "
"mécanismes de stockage). lnav s'ouvre ensuite en plein écran, encapsulé dans "
"un header/footer Omega-Fire — Ctrl-Q pour quitter, Ctrl-C pour copier la "
"ligne courante, la touche t pour changer de thème."
msgstr ""
"Item tersemat dan riwayat khusus 8.6 (terpisah dari 8.5, mekanisme "
"penyimpanan yang sama). lnav lalu terbuka layar penuh, dibungkus "
"header/footer Omega-Fire — Ctrl-Q untuk keluar, Ctrl-C untuk menyalin baris "
"saat ini, tombol t untuk mengganti tema."

#: src/omega_fire/interfaces/cli/help_text.py:912
msgid "Ferme Omega-Fire, avec une confirmation avant de quitter réellement."
msgstr "Menutup Omega-Fire, dengan konfirmasi sebelum benar-benar keluar."

#: src/omega_fire/interfaces/cli/help_text.py:913
msgid ""
"Réponds 'o' pour confirmer la fermeture, ou toute autre réponse pour rester "
"dans l'application."
msgstr ""
"Jawab 'o' untuk mengonfirmasi penutupan, atau jawaban lain apa pun untuk "
"tetap di aplikasi."

#: src/omega_fire/interfaces/cli/help_text.py:914
msgid ""
"Aucune sauvegarde automatique n'est déclenchée par cette confirmation — pense"
" à utiliser 7.1 avant de quitter si tu veux capturer l'état actuel."
msgstr ""
"Konfirmasi ini tidak memicu pencadangan otomatis — gunakan 7.1 sebelum keluar"
" jika ingin menyimpan status saat ini."

#: src/omega_fire/interfaces/cli/keybindings.py:32
#: src/omega_fire/interfaces/cli/renderers/dashboard.py:1091
#: src/omega_fire/interfaces/cli/renderers/dashboard.py:1116
msgid "Enter"
msgstr "Enter"

#: src/omega_fire/interfaces/cli/keybindings.py:33
#: src/omega_fire/interfaces/cli/renderers/dashboard.py:1094
#: src/omega_fire/interfaces/cli/renderers/dashboard.py:1108
#: src/omega_fire/interfaces/cli/renderers/dashboard.py:1119
msgid "Esc"
msgstr "Esc"

#: src/omega_fire/interfaces/cli/keybindings.py:41
msgid "Naviguer"
msgstr "Navigasi"

#: src/omega_fire/interfaces/cli/keybindings.py:42
#: src/omega_fire/interfaces/tui/screens/checklist.py:31
#: src/omega_fire/interfaces/tui/screens/restore_backup_screen.py:127
#: src/omega_fire/interfaces/tui/screens/rotate_logs_screen.py:128
msgid "Valider"
msgstr "Konfirmasi"

#: src/omega_fire/interfaces/cli/keybindings.py:43
msgid "Entrer"
msgstr "Masuk"

#: src/omega_fire/interfaces/cli/keybindings.py:44
#: src/omega_fire/interfaces/tui/screens/_base.py:51
#: src/omega_fire/interfaces/tui/screens/action_history_screen.py:56
#: src/omega_fire/interfaces/tui/screens/advanced_cleanup_screen.py:99
#: src/omega_fire/interfaces/tui/screens/app_log_screen.py:64
#: src/omega_fire/interfaces/tui/screens/apply_preset_screen.py:86
#: src/omega_fire/interfaces/tui/screens/backup_state_screen.py:46
#: src/omega_fire/interfaces/tui/screens/ban_ip_list_screen.py:161
#: src/omega_fire/interfaces/tui/screens/ban_ip_screen.py:86
#: src/omega_fire/interfaces/tui/screens/blocklist_file_detail_screen.py:77
