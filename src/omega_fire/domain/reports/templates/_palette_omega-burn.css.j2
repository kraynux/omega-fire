{# Palette "Omega-burn" — thème sombre chaud (braise / rouge-orangé). #}
:root {
    /* Fonds */
    --bg-body: #0a0000;
    --bg-container: #140505;
    --bg-header: #1f0a05;
    --bg-panel: #170808;
    --bg-panel-alt: #150606;
    --bg-table-wrapper: #0d0303;
    --bg-row-hover: #200a0a;

    /* Bordures */
    --border-default: #3a1a12;
    --border-panel: #3a2015;
    --border-header: #4a2515;
    --border-dashed: #3a2015;
    --border-footer: #2a1510;
    --border-cell: #241010;

    /* Texte */
    --text-body: #f0dcd0;
    --text-heading: #ffb380;
    --text-subheading: #f0a868;
    --text-accent: #e68a4a;
    --text-muted: #ba8a6a;
    --text-dim: #9a6a50;
    --text-value: #f8e8d8;
    --text-table-cell: #e0c8b0;
    --text-panel: #d4a888;
    --text-hover: #ffffff;

    /* Statuts sémantiques (badges, valeurs, anomalies) */
    --status-success-bg: #1a3a14;
    --status-success-text: #8ad07a;
    --status-success-border: #2e5c1e;

    --status-warning-bg: #3a2a10;
    --status-warning-text: #d0a07a;
    --status-warning-border: #5c4418;

    --status-neutral-bg: #2a2420;
    --status-neutral-text: #a09080;
    --status-neutral-border: #4a4038;

    --status-danger-bg: #4a1010;
    --status-danger-text: #ff8a6a;
    --status-danger-border: #6a2020;

    --status-info-bg: #2a1f10;
    --status-info-text: #e0b060;
    --status-info-border: #4a3818;

    /* Points de la fenêtre terminal (décor) */
    --dot-close-bg: #5a2020;
    --dot-close-border: #e68a6a;
    --dot-min-bg: #4a3010;
    --dot-min-border: #e0b060;
    --dot-max-bg: #2a3a10;
    --dot-max-border: #8ad07a;

    /* Encadrés d'anomalie */
    --anomaly-critical-bg: #3a1010;
    --anomaly-critical-text: #ffb0a0;
    --anomaly-warning-bg: #3a2410;
    --anomaly-warning-text: #e0c090;
}
