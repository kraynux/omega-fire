{# Palette "Light-basic" — thème clair sobre, façon rapport professionnel classique. #}
:root {
    /* Fonds */
    --bg-body: #f4f5f7;
    --bg-container: #ffffff;
    --bg-header: #f8f9fa;
    --bg-panel: #f8f9fa;
    --bg-panel-alt: #eef1f5;
    --bg-table-wrapper: #ffffff;
    --bg-row-hover: #f1f3f5;

    /* Bordures */
    --border-default: #dee2e6;
    --border-panel: #e0e4e8;
    --border-header: #dee2e6;
    --border-dashed: #ced4da;
    --border-footer: #dee2e6;
    --border-cell: #e9ecef;

    /* Texte */
    --text-body: #343a40;
    --text-heading: #212529;
    --text-subheading: #495057;
    --text-accent: #007bff;
    --text-muted: #6c757d;
    --text-dim: #868e96;
    --text-value: #212529;
    --text-table-cell: #343a40;
    --text-panel: #495057;
    --text-hover: #000000;

    /* Statuts sémantiques (badges, valeurs, anomalies) */
    --status-success-bg: #d4edda;
    --status-success-text: #1e7e34;
    --status-success-border: #86c79a;

    --status-warning-bg: #fff3cd;
    --status-warning-text: #856404;
    --status-warning-border: #e0c46c;

    --status-neutral-bg: #e9ecef;
    --status-neutral-text: #6c757d;
    --status-neutral-border: #ced4da;

    --status-danger-bg: #f8d7da;
    --status-danger-text: #a71d2a;
    --status-danger-border: #eba8ae;

    --status-info-bg: #d1ecf1;
    --status-info-text: #0c5460;
    --status-info-border: #86cfda;

    /* Points de la fenêtre terminal (décor) */
    --dot-close-bg: #f8d7da;
    --dot-close-border: #dc3545;
    --dot-min-bg: #fff3cd;
    --dot-min-border: #e0a800;
    --dot-max-bg: #d4edda;
    --dot-max-border: #28a745;

    /* Encadrés d'anomalie */
    --anomaly-critical-bg: #f8d7da;
    --anomaly-critical-text: #721c24;
    --anomaly-warning-bg: #fff3cd;
    --anomaly-warning-text: #856404;
}
