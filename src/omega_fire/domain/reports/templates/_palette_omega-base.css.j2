{# Palette "Omega-base" — thème sombre par défaut (bleu nuit / cyan). #}
:root {
    /* Fonds */
    --bg-body: #000000;
    --bg-container: #0a0a0a;
    --bg-header: #0d1420;
    --bg-panel: #070c14;
    --bg-panel-alt: #070b12;
    --bg-table-wrapper: #05070a;
    --bg-row-hover: #0b121c;

    /* Bordures */
    --border-default: #1a232f;
    --border-panel: #1a2a3e;
    --border-header: #1e3146;
    --border-dashed: #1e2a3a;
    --border-footer: #18202e;
    --border-cell: #121a24;

    /* Texte */
    --text-body: #e0e8f0;
    --text-heading: #b6d4fe;
    --text-subheading: #8bb4f0;
    --text-accent: #7aa9e6;
    --text-muted: #6a8cba;
    --text-dim: #5a7a9a;
    --text-value: #e0ecf8;
    --text-table-cell: #d0dce8;
    --text-panel: #b0c8e0;
    --text-hover: #ffffff;

    /* Statuts sémantiques (badges, valeurs, anomalies) */
    --status-success-bg: #123a24;
    --status-success-text: #7ad0a0;
    --status-success-border: #1e5c38;

    --status-warning-bg: #3a2f10;
    --status-warning-text: #d0c07a;
    --status-warning-border: #5c4c18;

    --status-neutral-bg: #2a2a2a;
    --status-neutral-text: #909090;
    --status-neutral-border: #444444;

    --status-danger-bg: #3a1414;
    --status-danger-text: #e68a8a;
    --status-danger-border: #5c2020;

    --status-info-bg: #2a1a3a;
    --status-info-text: #c0a0f0;
    --status-info-border: #4c2e5c;

    /* Points de la fenêtre terminal (décor) */
    --dot-close-bg: #5a2a2a;
    --dot-close-border: #e68a8a;
    --dot-min-bg: #3a3a1a;
    --dot-min-border: #d0c07a;
    --dot-max-bg: #1a3a2a;
    --dot-max-border: #7ad0a0;

    /* Encadrés d'anomalie */
    --anomaly-critical-bg: #2a1010;
    --anomaly-critical-text: #f0b0b0;
    --anomaly-warning-bg: #2a2410;
    --anomaly-warning-text: #e0d090;
}
