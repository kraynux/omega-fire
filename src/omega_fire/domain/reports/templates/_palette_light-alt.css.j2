{# Palette "Light-alt" — thème clair différencié (papier crème / vert forêt). #}
:root {
    /* Fonds */
    --bg-body: #faf6ee;
    --bg-container: #fffdf8;
    --bg-header: #f2ead8;
    --bg-panel: #f5efe1;
    --bg-panel-alt: #efe6d2;
    --bg-table-wrapper: #fffdf8;
    --bg-row-hover: #f0e8d5;

    /* Bordures */
    --border-default: #ddd0b0;
    --border-panel: #e0d4b8;
    --border-header: #d8c8a0;
    --border-dashed: #d0c090;
    --border-footer: #ddd0b0;
    --border-cell: #ece2c8;

    /* Texte */
    --text-body: #3a3226;
    --text-heading: #1e4d3a;
    --text-subheading: #2e5d4a;
    --text-accent: #1e7a5a;
    --text-muted: #8a7c5e;
    --text-dim: #a89a78;
    --text-value: #2a2418;
    --text-table-cell: #3a3226;
    --text-panel: #4a4030;
    --text-hover: #000000;

    /* Statuts sémantiques (badges, valeurs, anomalies) */
    --status-success-bg: #d8ecd8;
    --status-success-text: #1e5c30;
    --status-success-border: #7ab88a;

    --status-warning-bg: #f4e4c0;
    --status-warning-text: #7a5a10;
    --status-warning-border: #d0a850;

    --status-neutral-bg: #ece4d0;
    --status-neutral-text: #7a7060;
    --status-neutral-border: #cabf9e;

    --status-danger-bg: #f0d4ca;
    --status-danger-text: #8a3020;
    --status-danger-border: #d09070;

    --status-info-bg: #d4e4e8;
    --status-info-text: #1a5560;
    --status-info-border: #7ab0ba;

    /* Points de la fenêtre terminal (décor) */
    --dot-close-bg: #f0d4ca;
    --dot-close-border: #b85838;
    --dot-min-bg: #f4e4c0;
    --dot-min-border: #c09030;
    --dot-max-bg: #d8ecd8;
    --dot-max-border: #4a9060;

    /* Encadrés d'anomalie */
    --anomaly-critical-bg: #f0d4ca;
    --anomaly-critical-text: #6a2010;
    --anomaly-warning-bg: #f4e4c0;
    --anomaly-warning-text: #6a4a00;
}
