{# Palette "Omega-neon" — thème sombre saturé (cyberpunk, cyan/magenta). #}
:root {
    /* Fonds */
    --bg-body: #030308;
    --bg-container: #0a0a14;
    --bg-header: #10101e;
    --bg-panel: #0c0c1a;
    --bg-panel-alt: #0a0a16;
    --bg-table-wrapper: #060610;
    --bg-row-hover: #14142a;

    /* Bordures */
    --border-default: #2a2a4a;
    --border-panel: #2a2a5a;
    --border-header: #3a3a6a;
    --border-dashed: #2a2a5a;
    --border-footer: #22224a;
    --border-cell: #1a1a38;

    /* Texte */
    --text-body: #d8d8f8;
    --text-heading: #ff2ec4;
    --text-subheading: #00f0ff;
    --text-accent: #00f0ff;
    --text-muted: #8888c0;
    --text-dim: #6a6aa0;
    --text-value: #e8e8ff;
    --text-table-cell: #c8c8f0;
    --text-panel: #b0b0e8;
    --text-hover: #ffffff;

    /* Statuts sémantiques (badges, valeurs, anomalies) */
    --status-success-bg: #0a3a20;
    --status-success-text: #39ff9e;
    --status-success-border: #1e5c3a;

    --status-warning-bg: #3a2a00;
    --status-warning-text: #ffe600;
    --status-warning-border: #5c4400;

    --status-neutral-bg: #2a2a3a;
    --status-neutral-text: #9090b0;
    --status-neutral-border: #44445a;

    --status-danger-bg: #3a0020;
    --status-danger-text: #ff3860;
    --status-danger-border: #5c0030;

    --status-info-bg: #001a3a;
    --status-info-text: #00b8ff;
    --status-info-border: #003a5c;

    /* Points de la fenêtre terminal (décor) */
    --dot-close-bg: #3a0020;
    --dot-close-border: #ff3860;
    --dot-min-bg: #3a2a00;
    --dot-min-border: #ffe600;
    --dot-max-bg: #0a3a20;
    --dot-max-border: #39ff9e;

    /* Encadrés d'anomalie */
    --anomaly-critical-bg: #3a0020;
    --anomaly-critical-text: #ff6a9a;
    --anomaly-warning-bg: #3a2a00;
    --anomaly-warning-text: #ffe680;
}
